local function ClearVision()
    -- Xóa sóng năng lượng
    for _, v in pairs(workspace:GetChildren()) do if v.Name == "VisionWave" then v:Destroy() end end
    
    -- Xóa ESP và nhãn
    for _, esp in pairs(VisionState.ESPs) do if esp then esp:Destroy() end end
    VisionState.ESPs = {}
    
    -- Phục hồi hitbox
    for char, size in pairs(VisionState.Hitboxes) do
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.Size = size
            char.HumanoidRootPart.Transparency = 1
            char.HumanoidRootPart.CanCollide = true
        end
    end
    VisionState.Hitboxes = {}
    
    -- Phục hồi đồ họa
    Lighting.Ambient = VisionState.OriginalLighting.Ambient
    Lighting.GlobalShadows = VisionState.OriginalLighting.GlobalShadows
    Lighting.Brightness = VisionState.OriginalLighting.Brightness
    Lighting.OutdoorAmbient = VisionState.OriginalLighting.OutdoorAmbient
end

local function CreateWave(color)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local wave = Instance.new("Part", workspace)
    wave.Name = "VisionWave"; wave.Shape = Enum.PartType.Ball; wave.Size = Vector3.new(1, 1, 1)
    wave.CFrame = root.CFrame; wave.Color = color; wave.Material = Enum.Material.ForceField
    wave.Anchored = true; wave.CanCollide = false
    TweenService:Create(wave, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = Vector3.new(800, 800, 800), Transparency = 1}):Play()
    Debris:AddItem(wave, 1.5)
end

local function CreateESP(target, color, textName)
    if not target or not target.PrimaryPart then return end
    
    -- ESP Xuyên tường
    local hl = Instance.new("Highlight")
    hl.Parent = target
    hl.FillColor = color
    hl.OutlineColor = Color3.new(1,1,1)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    table.insert(VisionState.ESPs, hl)
    
    -- Chữ hiển thị
    local bgui = Instance.new("BillboardGui", target.PrimaryPart)
    bgui.Size = UDim2.new(0, 100, 0, 40)
    bgui.StudsOffset = Vector3.new(0, 3, 0)
    bgui.AlwaysOnTop = true
    local txt = Instance.new("TextLabel", bgui)
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = textName
    txt.TextColor3 = color
    txt.TextStrokeTransparency = 0
    txt.Font = Enum.Font.GothamBold
    txt.TextScaled = true
    table.insert(VisionState.ESPs, bgui)
end

