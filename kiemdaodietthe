-- ==========================================
-- TÊN SẢN PHẨM: KIẾM ĐẠO DIỆT THẾ (CUTSCENE 10 GIÂY CHUẨN ANIME)
-- TÁC GIẢ: Em trai làm mướn
-- CHÚ Ý: Chống chỉ định spam, đã tích hợp Cooldown và dọn dẹp Memory
-- ==========================================

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Window = Rayfield:CreateWindow({
    Name = "MinT Kiếm Đạo ⚔️",
    LoadingTitle = "Tụ Khí Đan Điền...",
    LoadingSubtitle = "Vạn Kiếm Quy Tông!",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local TabSword = Window:CreateTab("⚔️ Kiếm Đạo Diệt Thế", nil)

-- ==========================================
-- HỆ THỐNG TRẠNG THÁI & COOLDOWN
-- ==========================================
local SwordState = {
    IsTransformed = false,
    LastCastTime = 0,
    Cooldown = 15,
    RealmPos = Vector3.new(0, 100000, 0),
    GuardianSwords = {}
}

local originalJoints = {}

-- ==========================================
-- HÀM HỖ TRỢ: TẠO KIẾM 3D (Không dùng Mesh rác)
-- ==========================================
local function BuildSword(scale, isGlowing)
    local model = Instance.new("Model")
    
    -- Lưỡi kiếm (Blade)
    local blade = Instance.new("Part", model)
    blade.Name = "Blade"
    blade.Size = Vector3.new(0.2 * scale, 4 * scale, 0.6 * scale)
    blade.Color = isGlowing and Color3.fromRGB(150, 255, 255) or Color3.fromRGB(200, 200, 200)
    blade.Material = isGlowing and Enum.Material.Neon or Enum.Material.Metal
    blade.Anchored = true; blade.CanCollide = false
    model.PrimaryPart = blade
    
    -- Chuôi kiếm (Hilt)
    local hilt = Instance.new("Part", model)
    hilt.Size = Vector3.new(0.25 * scale, 1 * scale, 0.25 * scale)
    hilt.Color = Color3.fromRGB(255, 215, 0) -- Vàng gold
    hilt.Material = Enum.Material.Metal
    hilt.Anchored = true; hilt.CanCollide = false
    hilt.CFrame = blade.CFrame * CFrame.new(0, -2.5 * scale, 0)
    
    -- Hộ thủ chữ thập (Guard)
    local guard = Instance.new("Part", model)
    guard.Size = Vector3.new(0.3 * scale, 0.2 * scale, 1.5 * scale)
    guard.Color = Color3.fromRGB(255, 215, 0)
    guard.Material = Enum.Material.Metal
    guard.Anchored = true; guard.CanCollide = false
    guard.CFrame = blade.CFrame * CFrame.new(0, -2 * scale, 0)

    -- Nhóm lại
    return model
end

local function PlaySound(id, vol, pitch, parent)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. tostring(id)
    s.Volume = vol or 2; s.Pitch = pitch or 1
    s.Parent = parent or workspace
    s:Play()
    Debris:AddItem(s, 10)
end

-- ==========================================
-- HÀM BẺ XƯƠNG (POSE) CHO R15
-- ==========================================
local function SetPose(char, state)
    if not char:FindFirstChild("RightUpperArm") then return end -- Bỏ qua nếu là R6
    
    local rArm = char.RightUpperArm:FindFirstChild("RightShoulder")
    local rLeg = char.RightUpperLeg:FindFirstChild("RightHip")
    
    if state then
        if rArm then 
            originalJoints.rArm = rArm.C0
            TweenService:Create(rArm, TweenInfo.new(0.5), {C0 = originalJoints.rArm * CFrame.Angles(0, 0, math.rad(90))}):Play()
        end
        if rLeg then
            originalJoints.rLeg = rLeg.C0
            TweenService:Create(rLeg, TweenInfo.new(0.5), {C0 = originalJoints.rLeg * CFrame.Angles(math.rad(30), 0, 0)}):Play()
        end
    else
        if rArm and originalJoints.rArm then rArm.C0 = originalJoints.rArm end
        if rLeg and originalJoints.rLeg then rLeg.C0 = originalJoints.rLeg end
        originalJoints = {}
    end
end

-- ==========================================
-- CHIÊU THỨC: BIẾN HÌNH
-- ==========================================
TabSword:CreateButton({
    Name = "Nhận: ⚔️ Ấn Ký Kiếm Đạo",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name = "⚔️ Biến Hình"
        tool.RequiresHandle = false
        
        tool.Activated:Connect(function()
            local currentTime = tick()
            if currentTime - SwordState.LastCastTime < SwordState.Cooldown then
                Rayfield:Notify({Title = "Tụ Khí Lại", Content = "Đang hồi chiêu! Chờ " .. math.ceil(SwordState.Cooldown - (currentTime - SwordState.LastCastTime)) .. "s nữa.", Duration = 2})
                return
            end
            
            if SwordState.IsTransformed then
                Rayfield:Notify({Title = "Cảnh Báo", Content = "Đã biến hình rồi, dùng nút Hủy Dạng đi!", Duration = 2})
                return
            end

            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            
            SwordState.LastCastTime = currentTime
            SwordState.IsTransformed = true
            
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            
            hum.WalkSpeed = 0; hum.JumpPower = 0
            root.Anchored = true
            
            -- [1] TẠO KHÔNG GIAN ẢO BÃI KIẾM
            local realmBase = Instance.new("Part", workspace)
            realmBase.Size = Vector3.new(200, 1, 200)
            realmBase.CFrame = CFrame.new(SwordState.RealmPos)
            realmBase.Color = Color3.fromRGB(10, 10, 15)
            realmBase.Material = Enum.Material.Slate
            realmBase.Anchored = true
            
            local fog = Instance.new("Atmosphere", Lighting)
            fog.Density = 0.5; fog.Color = Color3.fromRGB(50, 0, 80)
            
            -- Trồng 30 thanh kiếm xịn làm màu
            local fakeSwords = {}
            for i = 1, 30 do
                local s = BuildSword(0.8, false)
                s.Parent = workspace
                local randomOffset = Vector3.new(math.random(-40, 40), 2, math.random(-40, 40))
                s.PrimaryPart.CFrame = CFrame.new(SwordState.RealmPos + randomOffset) * CFrame.Angles(math.rad(math.random(160, 200)), math.random(-3, 3), 0)
                table.insert(fakeSwords, s)
            end

            -- Chuyển Camera đến Bãi Kiếm
            Camera.CameraType = Enum.CameraType.Scriptable
            Camera.CFrame = CFrame.lookAt(SwordState.RealmPos + Vector3.new(0, 10, 40), SwordState.RealmPos)
            PlaySound(142070127, 2, 0.5) -- Âm thanh ma mị
            
            -- [2] KIẾM BAY VỀ MỘT HƯỚNG (2 GIÂY)
            task.wait(1)
            PlaySound(4446671048, 1.5, 1.2) -- Tiếng kiếm rút khỏi vỏ
            for _, s in ipairs(fakeSwords) do
                TweenService:Create(s.PrimaryPart, TweenInfo.new(1, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {
                    CFrame = s.PrimaryPart.CFrame * CFrame.new(0, 100, -200)
                }):Play()
            end
            
            task.wait(2)
            
            -- [3] CHUYỂN CẢNH: NHÂN VẬT PHÓNG LÊN TRỜI (150m)
            local blur = Instance.new("BlurEffect", Lighting); blur.Size = 50
            TweenService:Create(blur, TweenInfo.new(0.5), {Size = 0}):Play()
            Debris:AddItem(blur, 0.5)
            
            realmBase:Destroy(); fog:Destroy()
            for _, s in pairs(fakeSwords) do s:Destroy() end
            
            root.CFrame = root.CFrame * CFrame.new(0, 150, 0)
            Camera.CFrame = CFrame.lookAt(root.Position + Vector3.new(0, 2, -15), root.Position)
            SetPose(char, true) -- Cường giả kết ấn
            
            PlaySound(864568856, 1, 2) -- Âm thanh nổ uy lực
            
            -- [4] MƯA KIẾM RƠI XUỐNG XUNG QUANH (2 GIÂY)
            for i = 1, 20 do
                task.spawn(function()
                    local rainSword = BuildSword(0.6, true)
                    rainSword.Parent = workspace
                    local spawnPos = root.Position + Vector3.new(math.random(-20, 20), 50, math.random(-20, 20))
                    rainSword.PrimaryPart.CFrame = CFrame.new(spawnPos) * CFrame.Angles(math.rad(-90), 0, 0)
                    
                    local fallTw = TweenService:Create(rainSword.PrimaryPart, TweenInfo.new(0.5), {
                        CFrame = rainSword.PrimaryPart.CFrame * CFrame.new(0, -100, 0)
                    })
                    fallTw:Play()
                    fallTw.Completed:Wait()
                    rainSword:Destroy()
                end)
                task.wait(0.1)
            end
            
            task.wait(1)
            
            -- [5] 3 THANH ĐẠI KIẾM HỘ THỂ BÁM THEO
            SetPose(char, false)
            root.Anchored = false
            Camera.CameraType = Enum.CameraType.Custom
            hum.WalkSpeed = 50; hum.JumpPower = 60
            
            local swordPositions = {
                {offset = CFrame.new(-3, 2, 0) * CFrame.Angles(math.rad(180), 0, 0), scale = 1.2}, -- Vai trái (cắm xuống)
                {offset = CFrame.new(3, 2, 0) * CFrame.Angles(math.rad(180), 0, 0), scale = 1.2},  -- Vai phải (cắm xuống)
                {offset = CFrame.new(0, 1, 2) * CFrame.Angles(math.rad(45), 0, math.rad(-45)), scale = 1.5} -- Sau lưng (chéo)
            }
            
            for _, pos in ipairs(swordPositions) do
                local gs = BuildSword(pos.scale, true)
                gs.Parent = workspace
                gs.PrimaryPart.Anchored = false
                
                -- Hàn (Weld) kiếm dính vào RootPart để chạy theo nhân vật
                local weld = Instance.new("Weld", gs.PrimaryPart)
                weld.Part0 = root
                weld.Part1 = gs.PrimaryPart
                weld.C0 = pos.offset
                
                table.insert(SwordState.GuardianSwords, gs)
            end

            -- Hiệu ứng xoay tròn tại chỗ cho 2 kiếm 2 bên vai (Dùng RunService)
            RunService:BindToRenderStep("SpinSwords", Enum.RenderPriority.Character.Value, function()
                if SwordState.GuardianSwords[1] and SwordState.GuardianSwords[2] then
                    local w1 = SwordState.GuardianSwords[1].PrimaryPart:FindFirstChildOfClass("Weld")
                    local w2 = SwordState.GuardianSwords[2].PrimaryPart:FindFirstChildOfClass("Weld")
                    if w1 and w2 then
                        w1.C0 = w1.C0 * CFrame.Angles(0, math.rad(5), 0)
                        w2.C0 = w2.C0 * CFrame.Angles(0, math.rad(5), 0)
                    end
                end
            end)

            PlaySound(231917744, 2, 3)
            Rayfield:Notify({Title = "Hoàn Tất", Content = "Kiếm Ý Tụ Đỉnh! Chém chết tụi nó đi chị!", Duration = 3})
        end)
    end
})

-- ==========================================
-- HỦY DẠNG (TRẢ LẠI BÌNH THƯỜNG)
-- ==========================================
TabSword:CreateButton({
    Name = "🧹 Thu Kiếm (Hủy Dạng)",
    Callback = function()
        if not SwordState.IsTransformed then return end
        
        SwordState.IsTransformed = false
        RunService:UnbindFromRenderStep("SpinSwords")
        
        for _, s in pairs(SwordState.GuardianSwords) do
            if s then s:Destroy() end
        end
        SwordState.GuardianSwords = {}
        
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end
            SetPose(char, false)
        end
        
        if Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Custom
        end
        
        Rayfield:Notify({Title = "Thu Công", Content = "Đã thu lại kiếm khí.", Duration = 2})
    end
})
