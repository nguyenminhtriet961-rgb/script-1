TabSword:CreateButton({
    Name = "Vật Phẩm 8: 🔄 Vạn Kiếm Quy Tông",
    Callback = function()
        if player.Backpack:FindFirstChild("🔄 Vạn Kiếm Quy Tông") or (player.Character and player.Character:FindFirstChild("🔄 Vạn Kiếm Quy Tông")) then return end
        local tool = Instance.new("Tool"); tool.Name = "🔄 Vạn Kiếm Quy Tông"; tool.RequiresHandle = false; tool.Parent = player.Backpack

        tool.Activated:Connect(function()
            local char = player.Character; local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return end

            -- 1. Dọn dẹp kiếm cũ bị lỗi hoặc kẹt
            for _, s in pairs(SwordState.GuardianSwords) do
                if s and s:IsA("Model") then s:Destroy() end
            end
            SwordState.GuardianSwords = {}
            RunService:UnbindFromRenderStep("SpinSwords")

            -- 2. Ép trạng thái biến hình để xài được chiêu khác
            SwordState.IsTransformed = true

            -- Tọa độ chuẩn của 3 thanh kiếm
            local swordPos = {
                {off = CFrame.new(-4, 3, 0) * CFrame.Angles(math.rad(180), 0, 0), sc = 1.5},
                {off = CFrame.new(4, 3, 0) * CFrame.Angles(math.rad(180), 0, 0), sc = 1.5},
                {off = CFrame.new(0, 1, 3) * CFrame.Angles(math.rad(45), 0, math.rad(-45)), sc = 1.5}
            }

            PlaySound(142070127, 4, 1) -- Âm thanh triệu hồi vang dội

            -- 3. Triệu hồi kiếm từ trên cao lao xuống
            for _, p in ipairs(swordPos) do
                -- BuildSword là hàm đã có sẵn ở tuốt trên cùng script của em
                local gs = BuildSword(p.sc, true, true) 
                gs.Parent = workspace; gs.PrimaryPart.Anchored = false
                
                -- Đặt vị trí ban đầu tích tụ trên trời
                gs.PrimaryPart.CFrame = root.CFrame * CFrame.new(math.random(-30, 30), 200, math.random(-30, 30))
                
                local w = Instance.new("Weld", gs.PrimaryPart); w.Part0 = root; w.Part1 = gs.PrimaryPart
                w.C0 = p.off * CFrame.new(0, 200, 0) -- Weld từ khoảng cách 200m

                -- Tween lao vút xuống lưng
                TweenService:Create(w, TweenInfo.new(1, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {C0 = p.off}):Play()
                table.insert(SwordState.GuardianSwords, gs)
            end

            task.wait(1)

            -- 4. Bật lại hoạt ảnh xoay bảo vệ cho 2 kiếm ở vai
            RunService:BindToRenderStep("SpinSwords", 200, function()
                if SwordState.GuardianSwords[1] and SwordState.GuardianSwords[2] then
                    SwordState.GuardianSwords[1].PrimaryPart.Weld.C0 *= CFrame.Angles(0, math.rad(3), 0)
                    SwordState.GuardianSwords[2].PrimaryPart.Weld.C0 *= CFrame.Angles(0, math.rad(3), 0)
                end
            end)
            
            Rayfield:Notify({Title = "Quy Tông", Content = "Đã phục hồi 3 thanh Thánh Kiếm!", Duration = 3})
        end)
    end
})
