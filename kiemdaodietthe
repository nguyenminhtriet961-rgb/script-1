 
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Window = Rayfield:CreateWindow({
    Name = "MinT Kiếm Đạo ⚔️",
    LoadingTitle = "Tụ Khí Đan Điền...",
    LoadingSubtitle = "Vạn Kiếm Quy Tông!",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local TabSword = Window:CreateTab("⚔️ Kiếm Đạo Diệt Thế", nil)

-- ==========================================
-- HỆ THỐNG TRẠNG THÁI & COOLDOWN
-- ==========================================
local SwordState = {
    IsTransformed = false,
    LastCastTime = 0,
    Cooldown = 15,
    GuardianSwords = {}
}

local originalJoints = {}

-- ==========================================
-- HÀM HỖ TRỢ: TẠO KIẾM (Form Thuôn Dài, Lưỡi Trắng, Chuôi Nâu Đen)
-- ==========================================
local function BuildSword(scale, isGlowing)
    local model = Instance.new("Model")
    
    -- Lưỡi kiếm (Blade) - Trắng
    local blade = Instance.new("Part", model)
    blade.Name = "Blade"
    blade.Size = Vector3.new(0.1 * scale, 5 * scale, 0.4 * scale) -- Thuôn dài, không bè
    blade.Color = Color3.fromRGB(255, 255, 255) -- Trắng toát
    blade.Material = isGlowing and Enum.Material.Neon or Enum.Material.Metal
    blade.Anchored = true; blade.CanCollide = false
    model.PrimaryPart = blade
    
    -- Chuôi kiếm (Hilt) - Nâu Đen
    local hilt = Instance.new("Part", model)
    hilt.Size = Vector3.new(0.2 * scale, 1.2 * scale, 0.2 * scale)
    hilt.Color = Color3.fromRGB(40, 25, 15) -- Nâu đen
    hilt.Material = Enum.Material.Wood
    hilt.Anchored = true; hilt.CanCollide = false
    hilt.CFrame = blade.CFrame * CFrame.new(0, -3.1 * scale, 0)
    
    -- Vành kiếm (Guard/Tsuba) - Nhỏ gọn, dẹt
    local guard = Instance.new("Part", model)
    guard.Size = Vector3.new(0.3 * scale, 0.1 * scale, 0.5 * scale)
    guard.Color = Color3.fromRGB(20, 20, 20) -- Đen nhám
    guard.Material = Enum.Material.Metal
    guard.Anchored = true; guard.CanCollide = false
    guard.CFrame = blade.CFrame * CFrame.new(0, -2.5 * scale, 0)

    -- Nhóm lại
    for _, part in pairs({hilt, guard}) do
        local weld = Instance.new("WeldConstraint", blade)
        weld.Part0 = blade
        weld.Part1 = part
        part.Anchored = false -- Thả neo các part phụ để di chuyển mượt theo PrimaryPart
    end

    return model
end

local function PlaySound(id, vol, pitch, parent)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. tostring(id)
    s.Volume = vol or 2; s.Pitch = pitch or 1
    s.Parent = parent or workspace
    s:Play()
    Debris:AddItem(s, 10)
end

-- ==========================================
-- HÀM BẺ XƯƠNG (POSE) CHO R15
-- ==========================================
local function SetPose(char, state)
    if not char:FindFirstChild("RightUpperArm") then return end 
    
    local rArm = char.RightUpperArm:FindFirstChild("RightShoulder")
    local rLeg = char.RightUpperLeg:FindFirstChild("RightHip")
    
    if state then
        if rArm then 
            originalJoints.rArm = rArm.C0
            -- Bẻ tay lên trước mặt kết ấn
            TweenService:Create(rArm, TweenInfo.new(0.5), {C0 = originalJoints.rArm * CFrame.Angles(math.rad(90), math.rad(-45), 0)}):Play()
        end
        if rLeg then
            originalJoints.rLeg = rLeg.C0
            -- Co 1 chân ra sau
            TweenService:Create(rLeg, TweenInfo.new(0.5), {C0 = originalJoints.rLeg * CFrame.Angles(math.rad(30), 0, 0)}):Play()
        end
    else
        if rArm and originalJoints.rArm then TweenService:Create(rArm, TweenInfo.new(0.5), {C0 = originalJoints.rArm}):Play() end
        if rLeg and originalJoints.rLeg then TweenService:Create(rLeg, TweenInfo.new(0.5), {C0 = originalJoints.rLeg}):Play() end
        originalJoints = {}
    end
end

-- ==========================================
-- CHIÊU THỨC: BIẾN HÌNH
-- ==========================================
TabSword:CreateButton({
    Name = "Nhận: ⚔️ Ấn Ký Kiếm Đạo",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name = "⚔️ Biến Hình"
        tool.RequiresHandle = false
        
        tool.Activated:Connect(function()
            local currentTime = tick()
            if currentTime - SwordState.LastCastTime < SwordState.Cooldown then
                Rayfield:Notify({Title = "Tụ Khí Lại", Content = "Đang hồi chiêu! Chờ " .. math.ceil(SwordState.Cooldown - (currentTime - SwordState.LastCastTime)) .. "s nữa.", Duration = 2})
                return
            end
            
            if SwordState.IsTransformed then
                Rayfield:Notify({Title = "Cảnh Báo", Content = "Đã biến hình rồi, dùng nút Hủy Dạng đi!", Duration = 2})
                return
            end

            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            
            SwordState.LastCastTime = currentTime
            SwordState.IsTransformed = true
            
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            local startPos = root.Position
            
            hum.WalkSpeed = 0; hum.JumpPower = 0
            root.Anchored = true
            
            -- [1] TẠO KIẾM BAO VÂY XUNG QUANH NHÂN VẬT TẠI CHỖ
            PlaySound(142070127, 2, 0.5) -- Âm thanh ma mị
            
            local fakeSwords = {}
            local radius = 30
            for i = 1, 36 do -- Xếp kiếm thành vòng tròn lớn
                local angle = math.rad(i * 10)
                local s = BuildSword(0.8, false)
                s.Parent = workspace
                
                local spawnPos = startPos + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
                -- Mũi kiếm hướng về phía người chơi
                s.PrimaryPart.CFrame = CFrame.lookAt(spawnPos, startPos + Vector3.new(0, 2, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                table.insert(fakeSwords, s)
            end

            -- [2] KIẾM LAO VỀ PHÍA NGƯỜI CHƠI (2 GIÂY)
            task.wait(1)
            PlaySound(4446671048, 1.5, 1.2) -- Tiếng kiếm rút
            
            for _, s in ipairs(fakeSwords) do
                -- Tween kiếm cắm thẳng vào vị trí người chơi
                TweenService:Create(s.PrimaryPart, TweenInfo.new(1.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {
                    CFrame = s.PrimaryPart.CFrame * CFrame.new(0, -radius + 2, 0)
                }):Play()
            end
            
            task.wait(1.4) -- Đợi gần chạm thì phóng lên
            
            -- [3] PHÓNG LÊN TRỜI (150m) VÀ KẾT ẤN
            local blur = Instance.new("BlurEffect", Lighting); blur.Size = 30
            TweenService:Create(blur, TweenInfo.new(0.5), {Size = 0}):Play()
            Debris:AddItem(blur, 0.5)
            
            for _, s in pairs(fakeSwords) do s:Destroy() end -- Xóa kiếm nền
            
            root.CFrame = root.CFrame * CFrame.new(0, 150, 0)
            SetPose(char, true) -- Cường giả kết ấn
            
            PlaySound(864568856, 1, 2) -- Âm thanh nổ uy lực
            
            -- [4] MƯA KIẾM TRẮNG RƠI XUỐNG XUNG QUANH (2 GIÂY)
            for i = 1, 20 do
                task.spawn(function()
                    local rainSword = BuildSword(0.6, true)
                    rainSword.Parent = workspace
                    local spawnPos = root.Position + Vector3.new(math.random(-25, 25), 40, math.random(-25, 25))
                    rainSword.PrimaryPart.CFrame = CFrame.new(spawnPos) * CFrame.Angles(math.rad(-90), 0, 0)
                    
                    local fallTw = TweenService:Create(rainSword.PrimaryPart, TweenInfo.new(0.6, Enum.EasingStyle.Linear), {
                        CFrame = rainSword.PrimaryPart.CFrame * CFrame.new(0, -100, 0)
                    })
                    fallTw:Play()
                    fallTw.Completed:Wait()
                    rainSword:Destroy()
                end)
                task.wait(0.1)
            end
            
            task.wait(1)
            
            -- [5] 3 THANH ĐẠI KIẾM HỘ THỂ BÁM THEO
            SetPose(char, false)
            root.Anchored = false
            hum.WalkSpeed = 50; hum.JumpPower = 60
            
            local swordPositions = {
                {offset = CFrame.new(-3, 2, 0) * CFrame.Angles(math.rad(180), 0, 0), scale = 1.2}, -- Vai trái (cắm xuống)
                {offset = CFrame.new(3, 2, 0) * CFrame.Angles(math.rad(180), 0, 0), scale = 1.2},  -- Vai phải (cắm xuống)
                {offset = CFrame.new(0, 1, 2) * CFrame.Angles(math.rad(45), 0, math.rad(-45)), scale = 1.5} -- Sau lưng (chéo)
            }
            
            for _, pos in ipairs(swordPositions) do
                local gs = BuildSword(pos.scale, true)
                gs.Parent = workspace
                gs.PrimaryPart.Anchored = false
                
                -- Hàn (Weld) kiếm dính vào RootPart để chạy theo nhân vật
                local weld = Instance.new("Weld", gs.PrimaryPart)
                weld.Part0 = root
                weld.Part1 = gs.PrimaryPart
                weld.C0 = pos.offset
                
                table.insert(SwordState.GuardianSwords, gs)
            end

            -- Hiệu ứng xoay tròn tại chỗ cho 2 kiếm 2 bên vai (Dùng RunService)
            RunService:BindToRenderStep("SpinSwords", Enum.RenderPriority.Character.Value, function()
                if SwordState.GuardianSwords[1] and SwordState.GuardianSwords[2] then
                    local w1 = SwordState.GuardianSwords[1].PrimaryPart:FindFirstChildOfClass("Weld")
                    local w2 = SwordState.GuardianSwords[2].PrimaryPart:FindFirstChildOfClass("Weld")
                    if w1 and w2 then
                        w1.C0 = w1.C0 * CFrame.Angles(0, math.rad(5), 0)
                        w2.C0 = w2.C0 * CFrame.Angles(0, math.rad(5), 0)
                    end
                end
            end)

            PlaySound(231917744, 2, 3)
            Rayfield:Notify({Title = "Hoàn Tất", Content = "Kiếm Ý Tụ Đỉnh! Chém chết tụi nó đi chị!", Duration = 3})
        end)
    end
})

-- ==========================================
-- HỦY DẠNG (TRẢ LẠI BÌNH THƯỜNG)
-- ==========================================
TabSword:CreateButton({
    Name = "🧹 Thu Kiếm (Hủy Dạng)",
    Callback = function()
        if not SwordState.IsTransformed then return end
        
        SwordState.IsTransformed = false
        RunService:UnbindFromRenderStep("SpinSwords")
        
        for _, s in pairs(SwordState.GuardianSwords) do
            if s then s:Destroy() end
        end
        SwordState.GuardianSwords = {}
        
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end
            SetPose(char, false)
        end
        
        Rayfield:Notify({Title = "Thu Công", Content = "Đã thu lại kiếm khí.", Duration = 2})
    end
})
