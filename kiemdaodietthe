                local radius = math.sqrt(i / 500) * 80 
                local angle = i * 137.5 * (math.pi / 180) 
                local jitterX = math.random(-3, 3); local jitterZ = math.random(-3, 3)
                
                local offset = Vector3.new((radius * math.cos(angle)) + jitterX, -15, (radius * math.sin(angle)) + jitterZ)
                s.PrimaryPart.CFrame = CFrame.new(startPos + offset) * CFrame.Angles(math.rad(180 + math.random(-15, 15)), math.random(-30, 30), math.rad(math.random(-10, 10)))
                table.insert(tempSwords, s)
                
                local targetCFrame = CFrame.new(startPos + Vector3.new(offset.X, 0, offset.Z)) * CFrame.Angles(math.rad(180 + math.random(-15, 15)), math.random(-30, 30), math.rad(math.random(-10, 10)))
                TweenService:Create(s.PrimaryPart, TweenInfo.new(8, Enum.EasingStyle.Sine), {CFrame = targetCFrame}):Play()
            end

            -- Rung màn hình + Giật FOV (Zoom in/out liên tục)
            local shakeConn = RunService.RenderStepped:Connect(function()
                for _, s in pairs(tempSwords) do
                    s.PrimaryPart.CFrame = s.PrimaryPart.CFrame * CFrame.Angles(math.rad(math.random(-5, 5)), math.rad(math.random(-5, 5)), 0)
                end
                local camOffsetX = math.random(-50, 50) / 1000
                local camOffsetY = math.random(-50, 50) / 1000
                Camera.CFrame = Camera.CFrame * CFrame.Angles(camOffsetX, camOffsetY, 0)
                Camera.FieldOfView = 70 + math.random(-3, 3) -- Thao túng thị giác
            end)
            
            PlaySound(5094957444, 2, 0.7) 
            task.wait(8) 
            shakeConn:Disconnect()
            Camera.FieldOfView = 70 -- Trả lại FOV bình thường
            heartbeat:Destroy()

            -- [2.5] TỤ KHÍ TRƯỚC KHI BAY
            PlaySound(4446671048, 2, 0.5)
            for _, s in pairs(tempSwords) do
                local gatherPos = root.CFrame * CFrame.new(math.random(-15, 15), math.random(-5, 15), math.random(-15, 15))
                local gatherRot = CFrame.Angles(math.rad(math.random(-45, 45)), math.rad(math.random(-45, 45)), math.rad(math.random(-45, 45)))
                TweenService:Create(s.PrimaryPart, TweenInfo.new(1.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {CFrame = gatherPos * gatherRot}):Play()
            end
            task.wait(1.5)

            -- [3] CỘT SÁNG MA THẦN & PHÓNG LÊN TRỜI 
            -- Tạo cột sáng đen đỏ bắn thẳng lên trời
            local pillar = Instance.new("Part", workspace)
            pillar.Anchored = true; pillar.CanCollide = false
            pillar.Material = Enum.Material.Neon; pillar.Color = Color3.fromRGB(50, 0, 0)
            pillar.CFrame = CFrame.new(startPos + Vector3.new(0, 250, 0))
            pillar.Size = Vector3.new(1, 600, 1)
            local mesh = Instance.new("CylinderMesh", pillar)
            TweenService:Create(pillar, TweenInfo.new(0.3, Enum.EasingStyle.Exponential), {Size = Vector3.new(40, 600, 40)}):Play()
            TweenService:Create(pillar, TweenInfo.new(1), {Transparency = 1}):Play()
            Debris:AddItem(pillar, 1.5)

            PlaySound(864568856, 4, 0.8) -- Nổ tung bãi đất
            root.CFrame = root.CFrame * CFrame.new(0, 150, 0)
            for _, s in pairs(tempSwords) do
                TweenService:Create(s.PrimaryPart, TweenInfo.new(0.5, Enum.EasingStyle.Exponential), {CFrame = root.CFrame * CFrame.new(math.random(-20,20), math.random(-10,30), math.random(-20,20))}):Play()
            end
            task.wait(0.5)
            
            -- [4] SÁO TRỘN 10 LẦN KÈM TIẾNG KÍNH VỠ
            for shuffle = 1, 10 do
                PlaySound(4446671048, 0.5, 1.5)
                PlaySound(138084556, 1, math.random(8, 12)/10) -- Tiếng rạn nứt không gian
                for _, s in pairs(tempSwords) do
                    local randPos = root.CFrame * CFrame.new(math.random(-50, 50), math.random(-30, 50), math.random(-50, 50))
                    local randRot = CFrame.Angles(math.rad(math.random(0,360)), math.rad(math.random(0,360)), math.rad(math.random(0,360)))
                    TweenService:Create(s.PrimaryPart, TweenInfo.new(0.15, Enum.EasingStyle.Linear), {CFrame = randPos * randRot}):Play()
                end
                task.wait(0.15)
            end

            -- [5] NGẮM BẮN SONG SONG 
            PlaySound(864568856, 2, 2)
            for i, s in ipairs(tempSwords) do
                s.PrimaryPart.Material = Enum.Material.Neon
