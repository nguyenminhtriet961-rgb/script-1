                local flightConn
                flightConn = RunService.RenderStepped:Connect(function(dt)
                    t = t + dt * 0.2 -- LƯỚT CHẬM TRONG 5 GIÂY
                    if t >= 1 then 
                        flightConn:Disconnect()
                        
                        if not FlyingState.Sword or not FlyingState.Sword.PrimaryPart then
                            FlyingState.IsTransitioning = false
                            return 
                        end

                        FlyingState.Sword.PrimaryPart.CFrame = root.CFrame * CFrame.new(0, -3.2, 0) * CFrame.Angles(math.rad(-90), math.rad(90), 0)
                        
                        local weld = Instance.new("WeldConstraint", root)
                        weld.Name = "SwordWeld" 
                        weld.Part0 = root; weld.Part1 = FlyingState.Sword.PrimaryPart
                        FlyingState.Sword.PrimaryPart.Anchored = false
                        root.Anchored = false

                        local bv = Instance.new("BodyVelocity", root)
                        bv.MaxForce = Vector3.new(100000, 100000, 100000)
                        bv.Velocity = Vector3.new(0, 0, 0)
                        FlyingState.BodyVelocity = bv

                        local bg = Instance.new("BodyGyro", root)
                        bg.MaxTorque = Vector3.new(100000, 100000, 100000)
                        bg.P = 15000
                        FlyingState.BodyGyro = bg

                        RunService:BindToRenderStep("SwordSurfing", Enum.RenderPriority.Camera.Value + 1, function()
                            local camCFrame = workspace.CurrentCamera.CFrame
                            
                            -- XỬ LÝ DI CHUYỂN BẰNG NÚT ĐIỀU HƯỚNG CỦA ĐIỆN THOẠI (MoveDirection)
                            local moveDir = char.Humanoid.MoveDirection

                            -- Thêm hệ phím cho PC dùng chung
                            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCFrame.LookVector end
                            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCFrame.LookVector end
                            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCFrame.RightVector end
                            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCFrame.RightVector end
                            
                            -- KẾT HỢP BAY LÊN/HẠ XUỐNG CHO CẢ ĐIỆN THOẠI VÀ PC
                            if FlyingState.MobileUp or UserInputService:IsKeyDown(Enum.KeyCode.E) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                            if FlyingState.MobileDown or UserInputService:IsKeyDown(Enum.KeyCode.Q) then moveDir = moveDir - Vector3.new(0, 1, 0) end

                            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end

                            bv.Velocity = moveDir * FlyingState.Speed
                            bg.CFrame = CFrame.new(root.Position, root.Position + camCFrame.LookVector)
                        end)

                        FlyingState.IsTransitioning = false
                    else
                        local currentPos = QuadBezier(t, spawnPos, curvePoint, root.Position + Vector3.new(0, -3, 0))
                        if FlyingState.Sword and FlyingState.Sword.PrimaryPart then
                            FlyingState.Sword.PrimaryPart.CFrame = CFrame.lookAt(currentPos, root.Position + Vector3.new(0,-3,0)) * CFrame.Angles(math.rad(90), 0, 0)
                        end
                    end
                end)

            else
                -- ==========================
                -- TẮT VÀ HẠ CÁNH
                -- ==========================
                FlyingState.IsTransitioning = true
                RunService:UnbindFromRenderStep("SwordSurfing")
                RemoveMobileUI() -- TẮT NÚT CẢM ỨNG
                
                if FlyingState.BodyVelocity then FlyingState.BodyVelocity:Destroy() end
                if FlyingState.BodyGyro then FlyingState.BodyGyro:Destroy() end

                local raycastParams = RaycastParams.new()
                raycastParams.FilterDescendantsInstances = {char, FlyingState.Sword}
                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                local rayResult = workspace:Raycast(root.Position, Vector3.new(0, -1000, 0), raycastParams)

                if rayResult then
                    local landPos = rayResult.Position + Vector3.new(0, 3.5, 0)
                    local currentYRot = math.rad(root.Orientation.Y)
                    local landTween = TweenService:Create(root, TweenInfo.new(1.2, Enum.EasingStyle.Sine), {CFrame = CFrame.new(landPos) * CFrame.Angles(0, currentYRot, 0)})
                    landTween:Play()
                    landTween.Completed:Wait() 
                end

                char.Humanoid.PlatformStand = false
                SetPose(char, false)

                if FlyingState.Sword and FlyingState.Sword.PrimaryPart then
                    local swordRoot = FlyingState.Sword.PrimaryPart
                    
                    for _, v in pairs(root:GetChildren()) do
                        if v.Name == "SwordWeld" then v:Destroy() end
                    end
                    
                    swordRoot.Anchored = true
                    local awayPos = swordRoot.Position + (root.CFrame.LookVector * 300) + Vector3.new(0, 150, 0)
                    local flyAwayCFrame = CFrame.lookAt(swordRoot.Position, awayPos) * CFrame.Angles(math.rad(90), 0, 0)

                    local flyAwayTween = TweenService:Create(swordRoot, TweenInfo.new(4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {CFrame = flyAwayCFrame})
                    flyAwayTween:Play()
                    
                    Debris:AddItem(FlyingState.Sword, 4)
                end
                
                FlyingState.IsFlying = false
                FlyingState.IsTransitioning = false
            end
        end)
        
        Rayfield:Notify({Title = "Thông Báo", Content = "Đã tích hợp bảng điều khiển cảm ứng. Nhấp màn hình quẩy đi chị!", Duration = 4})
    end
})
