-- ==========================================
-- HÀM HỖ TRỢ: TẠO KIẾM & PHỤ KIỆN
-- ==========================================
local function BuildSword(scale, isGlowing, hasDarkAura)
    local model = Instance.new("Model")
    local blade = Instance.new("Part", model)
    blade.Name = "Blade"; blade.Size = Vector3.new(0.1 * scale, 5 * scale, 0.4 * scale)
    blade.Color = Color3.fromRGB(255, 255, 255); blade.Material = isGlowing and Enum.Material.Neon or Enum.Material.Metal
    blade.Anchored = true; blade.CanCollide = false; model.PrimaryPart = blade
    
    local tip = Instance.new("WedgePart", model)
    tip.Size = Vector3.new(0.1 * scale, 1 * scale, 0.4 * scale); tip.Color = blade.Color; tip.Anchored = false; tip.CanCollide = false
    tip.CFrame = blade.CFrame * CFrame.new(0, 3 * scale, 0)
    Instance.new("WeldConstraint", blade).Part0 = blade; tip.Parent = model; blade.Parent = model
    
    if hasDarkAura then
        local aura = Instance.new("ParticleEmitter", blade)
        aura.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(150, 0, 0))
        aura.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 0)})
        aura.Texture = "rbxassetid://243660364"; aura.Rate = 50; aura.Lifetime = NumberRange.new(0.5, 1)
    end
    return model
end

local function PlaySound(id, vol, pitch, parent)
    local s = Instance.new("Sound", parent or workspace)
    s.SoundId = "rbxassetid://" .. tostring(id); s.Volume = vol or 2; s.Pitch = pitch or 1
    s:Play(); Debris:AddItem(s, 15)
    return s
end

-- ==========================================
-- KỸ XẢO HÓA MA (ĐEN BẢN THỂ, MẮT ĐỎ)
-- ==========================================
local function MorphToDemon(char, state)
    for _, p in pairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            if state then
                if not p:GetAttribute("OrigCol") then p:SetAttribute("OrigCol", p.Color); p:SetAttribute("OrigMat", p.Material) end
                p.Color = Color3.new(0, 0, 0); p.Material = Enum.Material.Neon
            else
                p.Color = p:GetAttribute("OrigCol") or p.Color; p.Material = p:GetAttribute("OrigMat") or p.Material
            end
        elseif p:IsA("Decal") or p:IsA("Accessory") then
            p.Transparency = state and 1 or 0
        end
    end
    if state then
        local eye = Instance.new("Part", char)
        eye.Name = "DemonEye"; eye.Size = Vector3.new(0.4, 0.2, 0.1); eye.Color = Color3.new(1, 0, 0); eye.Material = Enum.Material.Neon
        eye.Anchored = false; eye.CanCollide = false
        local w = Instance.new("Weld", eye); w.Part0 = char.Head; w.Part1 = eye; w.C0 = CFrame.new(0, 0.2, -0.6)
        local trail = Instance.new("Trail", eye)
        trail.Color = ColorSequence.new(Color3.new(1, 0, 0)); trail.Lifetime = 0.5; trail.Attachment0 = Instance.new("Attachment", eye); trail.Attachment1 = Instance.new("Attachment", eye)
        trail.Attachment1.Position = Vector3.new(0, 0.2, 0)
    else
        if char:FindFirstChild("DemonEye") then char.DemonEye:Destroy() end
    end
end

