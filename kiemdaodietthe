local function PlaySound(id, vol, pitch, parent)
    local s = Instance.new("Sound", parent or workspace)
    s.SoundId = "rbxassetid://" .. tostring(id); s.Volume = vol or 2; s.Pitch = pitch or 1
    s:Play(); Debris:AddItem(s, 12)
    return s
end

local function SetPose(char, state, poseType)
    if not char:FindFirstChild("RightUpperArm") then return end 
    local joints = { rShoulder = char.RightUpperArm:FindFirstChild("RightShoulder"), lShoulder = char.LeftUpperArm:FindFirstChild("LeftShoulder"), rHip = char.RightUpperLeg:FindFirstChild("RightHip"), neck = char.Head:FindFirstChild("Neck") }
    if state then
        for name, joint in pairs(joints) do if joint and not originalJoints[name] then originalJoints[name] = joint.C0 end end
        if poseType == "Hover" then
            if joints.rShoulder then TweenService:Create(joints.rShoulder, TweenInfo.new(1), {C0 = originalJoints.rShoulder * CFrame.Angles(math.rad(20), math.rad(-40), math.rad(20))}):Play() end
            if joints.lShoulder then TweenService:Create(joints.lShoulder, TweenInfo.new(1), {C0 = originalJoints.lShoulder * CFrame.Angles(math.rad(20), math.rad(40), math.rad(-20))}):Play() end
            if joints.rHip then TweenService:Create(joints.rHip, TweenInfo.new(1), {C0 = originalJoints.rHip * CFrame.Angles(math.rad(10), 0, 0)}):Play() end
            if joints.neck then TweenService:Create(joints.neck, TweenInfo.new(1), {C0 = originalJoints.neck * CFrame.Angles(math.rad(-15), 0, 0)}):Play() end
        elseif poseType == "Sit" then
            if joints.rShoulder then TweenService:Create(joints.rShoulder, TweenInfo.new(0.5), {C0 = originalJoints.rShoulder * CFrame.Angles(math.rad(-20), 0, math.rad(20))}):Play() end
            if joints.lShoulder then TweenService:Create(joints.lShoulder, TweenInfo.new(0.5), {C0 = originalJoints.lShoulder * CFrame.Angles(math.rad(-20), 0, math.rad(-20))}):Play() end
            if joints.rHip then TweenService:Create(joints.rHip, TweenInfo.new(0.5), {C0 = originalJoints.rHip * CFrame.Angles(math.rad(90), 0, 0)}):Play() end
            local lHip = char.LeftUpperLeg:FindFirstChild("LeftHip")
            if lHip then originalJoints.lHip = originalJoints.lHip or lHip.C0; TweenService:Create(lHip, TweenInfo.new(0.5), {C0 = originalJoints.lHip * CFrame.Angles(math.rad(90), 0, 0)}):Play() end
        end
    else
        for name, joint in pairs(joints) do if joint and originalJoints[name] then TweenService:Create(joint, TweenInfo.new(0.5), {C0 = originalJoints[name]}):Play() end end
        local lHip = char.LeftUpperLeg:FindFirstChild("LeftHip")
        if lHip and originalJoints.lHip then TweenService:Create(lHip, TweenInfo.new(0.5), {C0 = originalJoints.lHip}):Play() end
    end
end

local function QuadBezier(t, p0, p1, p2) return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2 end

