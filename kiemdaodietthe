local function CreateLightningRift(cframe, scale, isFlat)
    local model = Instance.new("Model", workspace)
    local sc = scale or 1
    local p1 = Instance.new("Part", model); p1.Size = Vector3.new(4*sc, 15*sc, 2*sc)
    local p2 = Instance.new("Part", model); p2.Size = Vector3.new(4*sc, 20*sc, 2*sc)
    local p3 = Instance.new("Part", model); p3.Size = Vector3.new(4*sc, 15*sc, 2*sc)
    
    local rot = isFlat and CFrame.Angles(math.rad(90), 0, 0) or CFrame.Angles(0, 0, 0)

    p1.CFrame = cframe * rot * CFrame.new(0, 12*sc, 0) * CFrame.Angles(0, 0, math.rad(30))
    p2.CFrame = cframe * rot * CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(-30))
    p3.CFrame = cframe * rot * CFrame.new(0, -12*sc, 0) * CFrame.Angles(0, 0, math.rad(30))
    
    for _, p in pairs({p1, p2, p3}) do
        p.Color = Color3.fromRGB(0, 0, 30); p.Material = Enum.Material.Neon; p.Anchored = true; p.CanCollide = false
        local hl = Instance.new("Highlight", p); hl.FillTransparency = 1; hl.OutlineColor = Color3.fromRGB(0, 255, 0); hl.OutlineTransparency = 0
        local stars = Instance.new("ParticleEmitter", p); stars.Texture = "rbxassetid://217311100"; stars.Color = ColorSequence.new(Color3.fromRGB(150, 200, 255)); stars.Size = NumberSequence.new(2.5*sc, 0); stars.Rate = 80; stars.Speed = NumberRange.new(2*sc, 5*sc); stars.Lifetime = NumberRange.new(1, 2)
        table.insert(IgnoreList, p)
    end
    task.delay(5, function() if model then model:Destroy() end end)
    return model
end

local function CreateRipple(cframe, color, finalSize, duration)
    local wave = Instance.new("Part", workspace); wave.Size = Vector3.new(1, 0.1, 1); wave.CFrame = cframe; wave.Color = color; wave.Material = Enum.Material.Neon; wave.Anchored = true; wave.CanCollide = false
