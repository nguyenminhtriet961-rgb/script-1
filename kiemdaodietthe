            local swords = {
                SwordState.GuardianSwords[1].PrimaryPart,
                SwordState.GuardianSwords[2].PrimaryPart,
                SwordState.GuardianSwords[3].PrimaryPart
            }
            
            -- Tọa độ gốc của 3 thanh kiếm để tụi nó rút về
            local defaultPos = {
                CFrame.new(-4, 3, 0) * CFrame.Angles(math.rad(180), 0, 0),
                CFrame.new(4, 3, 0) * CFrame.Angles(math.rad(180), 0, 0),
                CFrame.new(0, 1, 3) * CFrame.Angles(math.rad(45), 0, math.rad(-45))
            }

            -- 1. CHÉM THAY PHIÊN TRONG 2.4 GIÂY (12 NHÁT)
            -- Mỗi lần lặp tốn ~0.2s => 12 lần = 2.4s
            for i = 1, 12 do
                local idx = ((i - 1) % 3) + 1 -- Luân phiên 1 -> 2 -> 3
                local currentSword = swords[idx]
                local baseC0 = defaultPos[idx]

                -- Lao lên chém
                PlaySound(138080210, 3, math.random(12, 16)/10) -- Âm thanh chém rít gió thay đổi pitch
                local targetC0 = CFrame.new(math.random(-3, 3), math.random(0, 5), -6) * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(90), 0)
                TweenService:Create(currentSword.Weld, TweenInfo.new(0.08, Enum.EasingStyle.Sine), {C0 = targetC0}):Play()
                
                -- Vệt sáng kiếm TRẮNG
                local slash = Instance.new("Part", workspace)
                slash.Size = Vector3.new(0.2, 20, 0.2); slash.Material = Enum.Material.Neon; slash.Color = Color3.fromRGB(255, 255, 255)
                slash.Anchored = true; slash.CanCollide = false
                slash.CFrame = root.CFrame * CFrame.new(0, 0, -5) * CFrame.Angles(0, 0, math.rad(math.random(-180, 180)))
                TweenService:Create(slash, TweenInfo.new(0.15), {Transparency = 1, Size = Vector3.new(0, 30, 0)}):Play()
                Debris:AddItem(slash, 0.15)
                
                task.wait(0.1)

                -- Rút kiếm về quỹ đạo
                TweenService:Create(currentSword.Weld, TweenInfo.new(0.1, Enum.EasingStyle.Sine), {C0 = baseC0}):Play()
                task.wait(0.1)
            end

            -- 2. NỔ BÙM VÀ KHÔNG GIAN VỠ NÁT MÀU TRẮNG
            PlaySound(864568856, 5, 1.2)
            local portalPos = root.CFrame * CFrame.new(0, 0, -6)

            -- Xả 60 mảnh vụn rớt lả tả
            for i = 1, 60 do
                local debrisPart = Instance.new("Part", workspace)
                debrisPart.Size = Vector3.new(math.random(1,4), math.random(1,4), math.random(1,4))
                debrisPart.Material = Enum.Material.Slate; debrisPart.Color = Color3.fromRGB(150, 150, 150) -- Đá xám trắng
                debrisPart.CFrame = portalPos * CFrame.Angles(math.rad(math.random(0,360)), math.rad(math.random(0,360)), 0)
                -- Lực văng từ tâm nổ
                debrisPart.Velocity = (root.CFrame.LookVector * math.random(30, 80)) + Vector3.new(math.random(-30,30), math.random(30, 70), math.random(-30,30))
                debrisPart.CanCollide = false -- Tắt va chạm để nhân vật lướt không bị kẹt
                Debris:AddItem(debrisPart, 3)
            end

            -- Cổng ánh sáng màu TRẮNG
            local portal = Instance.new("Part", workspace)
            portal.Size = Vector3.new(10, 12, 1); portal.CFrame = portalPos
            portal.Material = Enum.Material.Neon; portal.Color = Color3.fromRGB(255, 255, 255)
            portal.Anchored = true; portal.CanCollide = false
            
            local portalAura = Instance.new("ParticleEmitter", portal)
            portalAura.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
            portalAura.Size = NumberSequence.new(2, 0); portalAura.Rate = 100; portalAura.Speed = NumberRange.new(5, 10); portalAura.Lifetime = NumberRange.new(0.5, 1)
            Debris:AddItem(portal, 5)

            -- 3. NHÂN VẬT LƯỚT QUA (DỊCH CHUYỂN XUYÊN MỌI VẬT THỂ 25 MET)
            root.Anchored = false
            TweenService:Create(root, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {CFrame = root.CFrame * CFrame.new(0, 0, -25)}):Play()
            task.wait(0.3)
            char.Humanoid.WalkSpeed = 50

            -- 4. KIẾM TRỞ LẠI QUỸ ĐẠO QUAY BÌNH THƯỜNG
            TweenService:Create(swords[1].Weld, TweenInfo.new(0.5), {C0 = defaultPos[1]}):Play()
            TweenService:Create(swords[2].Weld, TweenInfo.new(0.5), {C0 = defaultPos[2]}):Play()
            TweenService:Create(swords[3].Weld, TweenInfo.new(0.5), {C0 = defaultPos[3]}):Play()
            
            task.wait(0.5)
            RunService:BindToRenderStep("SpinSwords", 200, function()
                if SwordState.GuardianSwords[1] and SwordState.GuardianSwords[2] then
                    swords[1].Weld.C0 *= CFrame.Angles(0, math.rad(3), 0)
                    swords[2].Weld.C0 *= CFrame.Angles(0, math.rad(3), 0)
                end
            end)

        end)
    end
})
