TabSword:CreateButton({
    Name = "Nhận Vật Phẩm: 🗡️ Ngự Kiếm",
    Callback = function()
        if player.Backpack:FindFirstChild("🗡️ Ngự Kiếm") or (player.Character and player.Character:FindFirstChild("🗡️ Ngự Kiếm")) then return end

        local tool = Instance.new("Tool"); tool.Name = "🗡️ Ngự Kiếm"; tool.RequiresHandle = false; tool.Parent = player.Backpack

        tool.Activated:Connect(function()
            local char = player.Character; local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root or FlyingState.IsTransitioning then return end

            if not FlyingState.IsFlying then
                FlyingState.IsTransitioning = true; FlyingState.IsFlying = true
                
                local sword = BuildRidingSword(); sword.Parent = workspace; FlyingState.Sword = sword
                local angle = math.random(0, 360)
                local spawnPos = root.Position + Vector3.new(170 * math.cos(math.rad(angle)), math.random(50, 150), 170 * math.sin(math.rad(angle)))
                local curvePoint = root.Position + Vector3.new(math.random(-100, 100), math.random(100, 200), math.random(-100, 100))

                PlaySound(138080210, 3, 1) 
                char.Humanoid.PlatformStand = true; root.Anchored = true; SetPose(char, true) 
                TweenService:Create(root, TweenInfo.new(1, Enum.EasingStyle.Sine), {CFrame = root.CFrame * CFrame.new(0, 8, 0)}):Play()
                CreateMobileUI()

                local t = 0; local flightConn
                flightConn = RunService.RenderStepped:Connect(function(dt)
                    t = t + dt * 0.2 
                    if t >= 1 then 
                        flightConn:Disconnect()
                        if not FlyingState.Sword or not FlyingState.Sword.PrimaryPart then FlyingState.IsTransitioning = false; return end

                        -- SỬA LỖI KIẾM DỰNG ĐỨNG Ở ĐÂY: Xoay flat mặt kiếm ngửa lên đỡ chân (math.rad(90) ở trục Y và Z)
                        FlyingState.Sword.PrimaryPart.CFrame = root.CFrame * CFrame.new(0, -3.2, 0) * CFrame.Angles(0, math.rad(90), math.rad(90))
                        
                        local weld = Instance.new("WeldConstraint", root); weld.Name = "SwordWeld"; weld.Part0 = root; weld.Part1 = FlyingState.Sword.PrimaryPart
                        FlyingState.Sword.PrimaryPart.Anchored = false; root.Anchored = false

                        local bv = Instance.new("BodyVelocity", root); bv.MaxForce = Vector3.new(100000, 100000, 100000); bv.Velocity = Vector3.new(0, 0, 0)
                        FlyingState.BodyVelocity = bv
                        local bg = Instance.new("BodyGyro", root); bg.MaxTorque = Vector3.new(100000, 100000, 100000); bg.P = 15000
                        FlyingState.BodyGyro = bg

                        RunService:BindToRenderStep("SwordSurfing", Enum.RenderPriority.Camera.Value + 1, function()
                            local camCFrame = workspace.CurrentCamera.CFrame
                            local moveDir = char.Humanoid.MoveDirection

                            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCFrame.LookVector end
                            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCFrame.LookVector end
                            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCFrame.RightVector end
                            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCFrame.RightVector end
                            
                            if FlyingState.MobileUp or UserInputService:IsKeyDown(Enum.KeyCode.E) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                            if FlyingState.MobileDown or UserInputService:IsKeyDown(Enum.KeyCode.Q) then moveDir = moveDir - Vector3.new(0, 1, 0) end

                            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
                            bv.Velocity = moveDir * FlyingState.Speed; bg.CFrame = CFrame.new(root.Position, root.Position + camCFrame.LookVector)
                        end)
                        FlyingState.IsTransitioning = false
                    else
                        local currentPos = QuadBezier(t, spawnPos, curvePoint, root.Position + Vector3.new(0, -3, 0))
                        if FlyingState.Sword and FlyingState.Sword.PrimaryPart then
                            FlyingState.Sword.PrimaryPart.CFrame = CFrame.lookAt(currentPos, root.Position + Vector3.new(0,-3,0)) * CFrame.Angles(math.rad(90), 0, 0)
                        end
                    end
                end)
            else
                FlyingState.IsTransitioning = true; RunService:UnbindFromRenderStep("SwordSurfing"); RemoveMobileUI()
                if FlyingState.BodyVelocity then FlyingState.BodyVelocity:Destroy() end
                if FlyingState.BodyGyro then FlyingState.BodyGyro:Destroy() end

                local raycastParams = RaycastParams.new(); raycastParams.FilterDescendantsInstances = {char, FlyingState.Sword}; raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                local rayResult = workspace:Raycast(root.Position, Vector3.new(0, -1000, 0), raycastParams)

                if rayResult then
                    local landPos = rayResult.Position + Vector3.new(0, 3.5, 0); local currentYRot = math.rad(root.Orientation.Y)
                    local landTween = TweenService:Create(root, TweenInfo.new(1.2, Enum.EasingStyle.Sine), {CFrame = CFrame.new(landPos) * CFrame.Angles(0, currentYRot, 0)})
                    landTween:Play(); landTween.Completed:Wait() 
                end

                char.Humanoid.PlatformStand = false; SetPose(char, false)

                if FlyingState.Sword and FlyingState.Sword.PrimaryPart then
                    local swordRoot = FlyingState.Sword.PrimaryPart
                    for _, v in pairs(root:GetChildren()) do if v.Name == "SwordWeld" then v:Destroy() end end
                    
                    swordRoot.Anchored = true
                    local flatDirection = (root.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit
                    if flatDirection.Magnitude < 0.1 then flatDirection = root.CFrame.RightVector end 
                    
                    local awayPos = swordRoot.Position + (flatDirection * 300) + Vector3.new(0, 200, 0)
                    local flyAwayCFrame = CFrame.lookAt(swordRoot.Position, awayPos) * CFrame.Angles(math.rad(90), 0, 0)
