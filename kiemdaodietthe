local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Window = Rayfield:CreateWindow({
    Name = "MinT Kiếm Đạo ⚔️",
    LoadingTitle = "Khởi động kỹ xảo...",
    LoadingSubtitle = "Đã tối ưu hóa FPS",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local TabSword = Window:CreateTab("⚔️ Kiếm Đạo Diệt Thế", nil)

local SwordState = {
    IsTransformed = false,
    LastCastTime = 0,
    Cooldown = 25, 
    GuardianSwords = {}
}

local originalJoints = {}

-- ==========================================
-- HÀM HỖ TRỢ: TẠO KIẾM & KỸ XẢO HẠT
-- ==========================================
local function BuildSword(scale, isGlowing, hasDarkAura)
    local model = Instance.new("Model")
    
    local blade = Instance.new("Part", model)
    blade.Name = "Blade"; blade.Size = Vector3.new(0.1 * scale, 5 * scale, 0.4 * scale)
    blade.Color = Color3.fromRGB(255, 255, 255); blade.Material = isGlowing and Enum.Material.Neon or Enum.Material.Metal
    blade.Anchored = true; blade.CanCollide = false; model.PrimaryPart = blade
    
    local tip = Instance.new("WedgePart", model)
    tip.Size = Vector3.new(0.1 * scale, 1 * scale, 0.4 * scale); tip.Color = blade.Color; tip.Material = blade.Material
    tip.Anchored = false; tip.CanCollide = false; tip.CFrame = blade.CFrame * CFrame.new(0, 3 * scale, 0)
    local wTip = Instance.new("WeldConstraint", blade); wTip.Part0 = blade; wTip.Part1 = tip
    
    local hilt = Instance.new("Part", model)
    hilt.Size = Vector3.new(0.2 * scale, 1.2 * scale, 0.2 * scale); hilt.Color = Color3.fromRGB(20, 10, 5); hilt.Material = Enum.Material.Fabric
    hilt.Anchored = false; hilt.CanCollide = false; hilt.CFrame = blade.CFrame * CFrame.new(0, -3.1 * scale, 0)
    local wHilt = Instance.new("WeldConstraint", blade); wHilt.Part0 = blade; wHilt.Part1 = hilt
    
    local guard = Instance.new("Part", model)
    guard.Size = Vector3.new(0.3 * scale, 0.1 * scale, 0.5 * scale); guard.Color = Color3.fromRGB(10, 10, 10); guard.Material = Enum.Material.Metal
    guard.Anchored = false; guard.CanCollide = false; guard.CFrame = blade.CFrame * CFrame.new(0, -2.5 * scale, 0)
    local wGuard = Instance.new("WeldConstraint", blade); wGuard.Part0 = blade; wGuard.Part1 = guard

    if hasDarkAura then
        local aura = Instance.new("ParticleEmitter", blade)
        aura.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 0, 50))
        aura.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.5 * scale), NumberSequenceKeypoint.new(1, 0)})
        aura.Texture = "rbxassetid://243660364" 
        aura.Rate = 50; aura.Speed = NumberRange.new(1, 3); aura.Lifetime = NumberRange.new(0.5, 1)
        aura.Rotation = NumberRange.new(0, 360); aura.RotSpeed = NumberRange.new(100, 200)
    end
    return model
end

local function AddBodyAura(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local aura = Instance.new("ParticleEmitter", root)
    aura.Name = "MinTAura"
    aura.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(200, 0, 0))
    aura.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 0)})
    aura.Texture = "rbxassetid://243660364" 
    aura.Rate = 150; aura.Speed = NumberRange.new(2, 6); aura.Lifetime = NumberRange.new(0.5, 1.2)
    aura.Rotation = NumberRange.new(0, 360); aura.RotSpeed = NumberRange.new(200, 400)
    aura.ZOffset = -1
    return aura
end

local function PlaySound(id, vol, pitch, parent)
    local s = Instance.new("Sound", parent or workspace)
    s.SoundId = "rbxassetid://" .. tostring(id); s.Volume = vol or 2; s.Pitch = pitch or 1
    s:Play(); Debris:AddItem(s, 12)
    return s
end

-- ==========================================
-- HÀM BẺ POSE CƯỜNG GIẢ (R15)
-- ==========================================
local function SetPose(char, state)
    if not char:FindFirstChild("RightUpperArm") then return end 
    local joints = {
        rShoulder = char.RightUpperArm:FindFirstChild("RightShoulder"),
        lShoulder = char.LeftUpperArm:FindFirstChild("LeftShoulder"),
        rHip = char.RightUpperLeg:FindFirstChild("RightHip"),
        neck = char.Head:FindFirstChild("Neck")
    }
    if state then
        for name, joint in pairs(joints) do if joint then originalJoints[name] = joint.C0 end end
        if joints.rShoulder then TweenService:Create(joints.rShoulder, TweenInfo.new(1), {C0 = joints.rShoulder.C0 * CFrame.Angles(math.rad(45), math.rad(-60), math.rad(30))}):Play() end
        if joints.lShoulder then TweenService:Create(joints.lShoulder, TweenInfo.new(1), {C0 = joints.lShoulder.C0 * CFrame.Angles(math.rad(45), math.rad(60), math.rad(-30))}):Play() end
        if joints.rHip then TweenService:Create(joints.rHip, TweenInfo.new(1), {C0 = joints.rHip.C0 * CFrame.Angles(math.rad(40), 0, 0)}):Play() end
        if joints.neck then TweenService:Create(joints.neck, TweenInfo.new(1), {C0 = joints.neck.C0 * CFrame.Angles(math.rad(20), 0, 0)}):Play() end
    else
        for name, joint in pairs(joints) do if joint and originalJoints[name] then joint.C0 = originalJoints[name] end end
        originalJoints = {}
    end
end

-- ==========================================
-- CHIÊU THỨC: BIẾN HÌNH DIỆT THẾ
-- ==========================================
TabSword:CreateButton({
    Name = "Nhận: ⚔️ Ấn Ký Kiếm Đạo (Cực Hạn)",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name = "⚔️ Biến Hình"; tool.RequiresHandle = false
        
        tool.Activated:Connect(function()
            local char = player.Character
            if not char or SwordState.IsTransformed or tick() - SwordState.LastCastTime < SwordState.Cooldown then return end
            
            SwordState.LastCastTime = tick(); SwordState.IsTransformed = true
            local root = char.HumanoidRootPart; local hum = char.Humanoid; local startPos = root.Position
            hum.WalkSpeed = 0; hum.JumpPower = 0; root.Anchored = true
            SetPose(char, true)

            -- [Ý tưởng 4 & 7]: Hóa Hắc Ám Bản Thể & Vệt Sáng Mắt
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                    v.Color = Color3.fromRGB(10, 10, 10)
                    v.Material = Enum.Material.Neon
                elseif v:IsA("Decal") and v.Name == "face" then
                    v.Color3 = Color3.fromRGB(255, 0, 0) -- Mắt đỏ ngầu
                elseif v:IsA("Clothing") or v:IsA("ShirtGraphic") then
                    v:Destroy() -- Lột sạch quần áo mặc định để lộ form đen
                end
            end
            AddBodyAura(char)

            -- [Ý tưởng 5]: Thao túng Bầu Trời (Huyết Nguyệt)
            local skyCC = Instance.new("ColorCorrectionEffect", Lighting)
            skyCC.Name = "SwordCC"
            TweenService:Create(skyCC, TweenInfo.new(3), {TintColor = Color3.fromRGB(255, 80, 80), Contrast = 0.5, Saturation = 0.8}):Play()

            -- [Ý tưởng 6]: Đạp Vỡ Hư Không (Shockwave khi bay lên)
            task.wait(2)
            PlaySound(864568856, 4, 0.8) 
            
            local shockwave = Instance.new("Part", workspace)
            shockwave.Size = Vector3.new(5, 1, 5); shockwave.CFrame = root.CFrame * CFrame.new(0, -2, 0)
            shockwave.Anchored = true; shockwave.CanCollide = false; shockwave.Material = Enum.Material.Neon
            shockwave.Color = Color3.fromRGB(255, 50, 50)
            local swMesh = Instance.new("CylinderMesh", shockwave)
            TweenService:Create(shockwave, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {Size = Vector3.new(150, 1, 150), Transparency = 1}):Play()
            Debris:AddItem(shockwave, 1)

            -- Bay lên trời
            root.CFrame = root.CFrame * CFrame.new(0, 150, 0)
            task.wait(0.5)

            -- [Ý tưởng 2]: Vòng Ma Pháp (Magic Circle phía sau)
            local magicCircle = Instance.new("Part", workspace)
            magicCircle.Size = Vector3.new(120, 120, 1)
            magicCircle.CFrame = root.CFrame * CFrame.new(0, 0, 10) -- Đứng sau lưng
            magicCircle.Anchored = true; magicCircle.CanCollide = false; magicCircle.Transparency = 1
            local decal = Instance.new("Decal", magicCircle)
            decal.Texture = "rbxassetid://1312389369" -- ID Vòng tròn ma thuật
            decal.Color3 = Color3.fromRGB(255, 0, 0)
            
            -- Xoay vòng ma pháp
            RunService:BindToRenderStep("SpinMagic", 1, function()
                if magicCircle then magicCircle.CFrame = magicCircle.CFrame * CFrame.Angles(0, 0, math.rad(2)) end
            end)

            -- Tạo 80 thanh kiếm (Tối ưu thay vì 500)
            local tempSwords = {}
            for i = 1, 80 do
                local s = BuildSword(2, true, false) 
                s.Parent = workspace
                local radius = math.random(10, 50)
                local angle = math.random(0, 360)
                local startCFrame = magicCircle.CFrame * CFrame.new(radius * math.cos(math.rad(angle)), radius * math.sin(math.rad(angle)), -5)
                s.PrimaryPart.CFrame = startCFrame * CFrame.Angles(math.rad(90), 0, 0)
                table.insert(tempSwords, s)
            end

            task.wait(1.5)

            -- [Ý tưởng 3]: Impact Frame (Khoảnh khắc tĩnh lặng tuyệt đối)
            local impact = Instance.new("ColorCorrectionEffect", Lighting)
            impact.Name = "ImpactCC"
            impact.Saturation = -1
            impact.Contrast = 1.5
            impact.Brightness = 0.5
            task.wait(0.4) -- Đứng hình trắng đen trong 0.4s
            impact:Destroy()

            -- Tiếng rách không gian (Sonic Boom)
            PlaySound(138080210, 5, 0.8) 
            
            -- Xả kiếm mượt mà
            for _, s in ipairs(tempSwords) do
                task.spawn(function()
                    local dest = s.PrimaryPart.CFrame * CFrame.new(0, -400, 0) 
                    local tw = TweenService:Create(s.PrimaryPart, TweenInfo.new(0.4, Enum.EasingStyle.Linear), {CFrame = dest})
                    tw:Play(); tw.Completed:Wait(); s:Destroy()
                end)
                task.wait(0.01) 
            end

            task.wait(1)
            RunService:UnbindFromRenderStep("SpinMagic")
            magicCircle:Destroy()
            
            -- Trả lại cử động
            SetPose(char, false); root.Anchored = false
            hum.WalkSpeed = 50; hum.JumpPower = 60
            
            -- Gọi thêm 3 thanh kiếm bảo hộ bám theo người (Từ bản cũ của chị)
            local swordPos = {
                {off = CFrame.new(-4, 3, 0) * CFrame.Angles(math.rad(180), 0, 0), sc = 1.5},
                {off = CFrame.new(4, 3, 0) * CFrame.Angles(math.rad(180), 0, 0), sc = 1.5},
                {off = CFrame.new(0, 1, 3) * CFrame.Angles(math.rad(45), 0, math.rad(-45)), sc = 1.5}
            }
            
            for _, p in ipairs(swordPos) do
                local gs = BuildSword(p.sc, true, true) 
                gs.Parent = workspace; gs.PrimaryPart.Anchored = false
                local w = Instance.new("Weld", gs.PrimaryPart); w.Part0 = root; w.Part1 = gs.PrimaryPart
                w.C0 = p.off * CFrame.new(math.random(-50, 50), 100, math.random(-50, 50))
                TweenService:Create(w, TweenInfo.new(3, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {C0 = p.off}):Play()
                table.insert(SwordState.GuardianSwords, gs)
            end

            RunService:BindToRenderStep("SpinSwords", 200, function()
                if SwordState.GuardianSwords[1] and SwordState.GuardianSwords[2] then
                    SwordState.GuardianSwords[1].PrimaryPart.Weld.C0 *= CFrame.Angles(0, math.rad(3), 0)
                    SwordState.GuardianSwords[2].PrimaryPart.Weld.C0 *= CFrame.Angles(0, math.rad(3), 0)
                end
            end)
            
            Rayfield:Notify({Title = "Hoàn Tất", Content = "Diệt thế xong rồi đấy!", Duration = 3})
        end)
    end
})

TabSword:CreateButton({
    Name = "🧹 Hủy Dạng",
    Callback = function()
        SwordState.IsTransformed = false
        RunService:UnbindFromRenderStep("SpinSwords")
        RunService:UnbindFromRenderStep("SpinMagic")
        
        -- Dọn dẹp kỹ xảo
        if Lighting:FindFirstChild("SwordCC") then Lighting.SwordCC:Destroy() end
        if Lighting:FindFirstChild("ImpactCC") then Lighting.ImpactCC:Destroy() end
        
        local char = player.Character
        if char then
            if char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart:FindFirstChild("MinTAura") then
                char.HumanoidRootPart.MinTAura:Destroy()
            end
            if char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = 16; char.Humanoid.JumpPower = 50
            end
            SetPose(char, false); char.HumanoidRootPart.Anchored = false
        end

        for _, s in pairs(SwordState.GuardianSwords) do if s then s:Destroy() end end
        SwordState.GuardianSwords = {}
        
        Rayfield:Notify({Title = "Cảnh báo", Content = "Đã tắt hiệu ứng. Nếu muốn lấy lại quần áo, vui lòng reset nhân vật.", Duration = 4})
    end
})
