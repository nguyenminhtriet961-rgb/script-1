-- KỸ NĂNG 10: KIẾM VŨ LIÊN HOÀN (ĐÁNH THƯỜNG COMBO 4 HIT)
-- ==========================================
local BasicAttackState = {
    Combo = 0,
    LastAttack = 0,
    IsAttacking = false,
    ResetTime = 1.5 -- Ngưng bấm 1.5s sẽ reset combo về 1
}

TabSword:CreateButton({
    Name = "Vật Phẩm 10: ⚔️ Đánh Thường",
    Callback = function()
        if player.Backpack:FindFirstChild("⚔️ Đánh Thường") or (player.Character and player.Character:FindFirstChild("⚔️ Đánh Thường")) then return end
        local tool = Instance.new("Tool"); tool.Name = "⚔️ Đánh Thường"; tool.RequiresHandle = false; tool.Parent = player.Backpack

        tool.Activated:Connect(function()
            local char = player.Character; local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root or not SwordState.IsTransformed or #SwordState.GuardianSwords < 3 then return end
            
            -- Khóa spam để animation không bị đè lên nhau
            if BasicAttackState.IsAttacking then return end
            
            -- Reset combo nếu ngưng bấm quá lâu
            if tick() - BasicAttackState.LastAttack > BasicAttackState.ResetTime then
                BasicAttackState.Combo = 0
            end
            
            BasicAttackState.Combo = BasicAttackState.Combo + 1
            if BasicAttackState.Combo > 4 then BasicAttackState.Combo = 1 end
            
            BasicAttackState.IsAttacking = true
            BasicAttackState.LastAttack = tick()

            -- Tắt hiệu ứng xoay lơ lửng để múa kiếm
            RunService:UnbindFromRenderStep("SpinSwords")

            local s1 = SwordState.GuardianSwords[1].PrimaryPart -- Kiếm trái
            local s2 = SwordState.GuardianSwords[2].PrimaryPart -- Kiếm phải
            local s3 = SwordState.GuardianSwords[3].PrimaryPart -- Kiếm giữa/sau

            -- Tọa độ gốc để thu kiếm về
            local def1 = CFrame.new(-4, 3, 0) * CFrame.Angles(math.rad(180), 0, 0)
            local def2 = CFrame.new(4, 3, 0) * CFrame.Angles(math.rad(180), 0, 0)
            local def3 = CFrame.new(0, 1, 3) * CFrame.Angles(math.rad(45), 0, math.rad(-45))

            -- Lướt về phía trước 1 tí (Dash nhẹ)
            root.Anchored = false
            TweenService:Create(root, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = root.CFrame * CFrame.new(0, 0, -3)}):Play()

            if BasicAttackState.Combo == 1 then
                -- NHÁT 1: Kiếm trái chém ngang từ trái qua phải (0.5s)
                PlaySound(138080210, 2, 1.2)
                TweenService:Create(s1.Weld, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {C0 = CFrame.new(0, 0, -5) * CFrame.Angles(math.rad(0), math.rad(90), math.rad(-90))}):Play()
                task.wait(0.25)
                TweenService:Create(s1.Weld, TweenInfo.new(0.25, Enum.EasingStyle.Sine), {C0 = def1}):Play()
                task.wait(0.25)

            elseif BasicAttackState.Combo == 2 then
                -- NHÁT 2: Kiếm phải chém ngang từ phải qua trái (0.5s)
                PlaySound(138080210, 2, 1.3)
                TweenService:Create(s2.Weld, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {C0 = CFrame.new(0, 0, -5) * CFrame.Angles(math.rad(0), math.rad(-90), math.rad(90))}):Play()
                task.wait(0.25)
                TweenService:Create(s2.Weld, TweenInfo.new(0.25, Enum.EasingStyle.Sine), {C0 = def2}):Play()
                task.wait(0.25)

            elseif BasicAttackState.Combo == 3 then
                -- NHÁT 3: Kiếm sau lưng lướt lên bổ củi từ trên xuống (0.5s)
                PlaySound(138080210, 2, 1.1)
                TweenService:Create(s3.Weld, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {C0 = CFrame.new(0, 3, -6) * CFrame.Angles(math.rad(-90), 0, 0)}):Play()
                task.wait(0.25)
                TweenService:Create(s3.Weld, TweenInfo.new(0.25, Enum.EasingStyle.Sine), {C0 = def3}):Play()
                task.wait(0.25)

            elseif BasicAttackState.Combo == 4 then
                -- NHÁT 4: 3 thanh kiếm cùng đập mạnh xuống đất (1s)
                PlaySound(138084556, 3, 0.8) -- Tiếng giơ kiếm
                TweenService:Create(s1.Weld, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {C0 = CFrame.new(-3, -2, -6) * CFrame.Angles(math.rad(-120), 0, math.rad(-30))}):Play()
                TweenService:Create(s2.Weld, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {C0 = CFrame.new(3, -2, -6) * CFrame.Angles(math.rad(-120), 0, math.rad(30))}):Play()
                TweenService:Create(s3.Weld, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {C0 = CFrame.new(0, -3, -7) * CFrame.Angles(math.rad(-130), 0, 0)}):Play()
                
                task.wait(0.3)
                
                -- Tạo dư chấn và đá vụn cực ngầu
                PlaySound(864568856, 4, 1) -- Tiếng nổ đất
                local shockwave = Instance.new("Part", workspace)
                shockwave.Size = Vector3.new(2, 1, 2); shockwave.CFrame = root.CFrame * CFrame.new(0, -3, -6)
                shockwave.Anchored = true; shockwave.CanCollide = false; shockwave.Material = Enum.Material.Neon; shockwave.Color = Color3.fromRGB(255, 100, 0)
                Instance.new("CylinderMesh", shockwave)
                TweenService:Create(shockwave, TweenInfo.new(0.5), {Size = Vector3.new(40, 1, 40), Transparency = 1}):Play()
                Debris:AddItem(shockwave, 0.5)

                -- Bắn vụn đá lên
                for i = 1, 15 do
                    local debrisPart = Instance.new("Part", workspace)
                    debrisPart.Size = Vector3.new(math.random(1,3), math.random(1,3), math.random(1,3))
                    debrisPart.Material = Enum.Material.Slate; debrisPart.Color = Color3.fromRGB(30, 30, 30)
                    debrisPart.CFrame = root.CFrame * CFrame.new(math.random(-5, 5), -2, math.random(-8, -4)) * CFrame.Angles(math.rad(math.random(0,360)), math.rad(math.random(0,360)), 0)
                    debrisPart.Velocity = Vector3.new(math.random(-30, 30), math.random(40, 80), math.random(-30, 30))
                    debrisPart.CanCollide = false
                    Debris:AddItem(debrisPart, 2)
                end
                
                task.wait(0.7)
                
                -- Thu cả 3 kiếm về
                TweenService:Create(s1.Weld, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {C0 = def1}):Play()
                TweenService:Create(s2.Weld, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {C0 = def2}):Play()
                TweenService:Create(s3.Weld, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {C0 = def3}):Play()
                task.wait(0.4)
            end
            
            -- Bật lại hiệu ứng xoay lơ lửng nếu đã chém xong
            RunService:BindToRenderStep("SpinSwords", 200, function()
                if SwordState.GuardianSwords[1] and SwordState.GuardianSwords[2] then
                    s1.Weld.C0 *= CFrame.Angles(0, math.rad(3), 0)
                    s2.Weld.C0 *= CFrame.Angles(0, math.rad(3), 0)
                end
            end)

            BasicAttackState.IsAttacking = false
        end)
    end
})
