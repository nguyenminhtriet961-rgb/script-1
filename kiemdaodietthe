local function CreateLightningRift(cframe)
    local model = Instance.new("Model", workspace)
    -- Tăng kích thước (Size) và Tọa độ giãn cách (CFrame) để làm nó bự hơn
    local p1 = Instance.new("Part", model); p1.Size = Vector3.new(4, 15, 2); p1.CFrame = cframe * CFrame.new(0, 12, 0) * CFrame.Angles(0, 0, math.rad(30))
    local p2 = Instance.new("Part", model); p2.Size = Vector3.new(4, 20, 2); p2.CFrame = cframe * CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(-30))
    local p3 = Instance.new("Part", model); p3.Size = Vector3.new(4, 15, 2); p3.CFrame = cframe * CFrame.new(0, -12, 0) * CFrame.Angles(0, 0, math.rad(30))
    
    for _, p in pairs({p1, p2, p3}) do
        p.Color = Color3.fromRGB(0, 0, 30); p.Material = Enum.Material.Neon; p.Anchored = true; p.CanCollide = false
        local hl = Instance.new("Highlight", p); hl.FillTransparency = 1; hl.OutlineColor = Color3.fromRGB(0, 255, 0); hl.OutlineTransparency = 0
        local stars = Instance.new("ParticleEmitter", p); stars.Texture = "rbxassetid://217311100"; stars.Color = ColorSequence.new(Color3.fromRGB(150, 200, 255)); stars.Size = NumberSequence.new(2.5, 0); stars.Rate = 80; stars.Speed = NumberRange.new(2, 5); stars.Lifetime = NumberRange.new(1, 2)
        table.insert(IgnoreList, p)
    end
    Debris:AddItem(model, 5)
    return model
end

local function QuadBezier(t, p0, p1, p2) return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2 end

