-- ==========================================
-- TÊN SẢN PHẨM: KIẾM ĐẠO DIỆT THẾ (BẢN FIX RUNG CHẤN & KIẾM TRẬN)
-- TÁC GIẢ: Em trai làm mướn
-- ==========================================

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
    Name = "MinT Kiếm Đạo ⚔️",
    LoadingTitle = "Ma Khí Xâm Chiếm...",
    LoadingSubtitle = "Vạn Kiếm Quy Tông!",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local TabSword = Window:CreateTab("⚔️ Kiếm Đạo Diệt Thế", nil)

local SwordState = {
    IsTransformed = false,
    LastCastTime = 0,
    Cooldown = 20,
    GuardianSwords = {}
}

local originalJoints = {}

-- ==========================================
-- HÀM HỖ TRỢ: TẠO KIẾM (Form Katana Trắng, Chuôi Nâu Đen)
-- ==========================================
local function BuildSword(scale, isGlowing)
    local model = Instance.new("Model")
    local blade = Instance.new("Part", model)
    blade.Name = "Blade"; blade.Size = Vector3.new(0.1 * scale, 5 * scale, 0.4 * scale)
    blade.Color = Color3.fromRGB(255, 255, 255); blade.Material = isGlowing and Enum.Material.Neon or Enum.Material.Metal
    blade.Anchored = true; blade.CanCollide = false; model.PrimaryPart = blade
    
    local hilt = Instance.new("Part", model)
    hilt.Size = Vector3.new(0.2 * scale, 1.2 * scale, 0.2 * scale); hilt.Color = Color3.fromRGB(40, 25, 15); hilt.Material = Enum.Material.Wood
    hilt.Anchored = true; hilt.CanCollide = false; hilt.CFrame = blade.CFrame * CFrame.new(0, -3.1 * scale, 0)
    
    local guard = Instance.new("Part", model)
    guard.Size = Vector3.new(0.3 * scale, 0.1 * scale, 0.5 * scale); guard.Color = Color3.fromRGB(20, 20, 20); guard.Material = Enum.Material.Metal
    guard.Anchored = true; guard.CanCollide = false; guard.CFrame = blade.CFrame * CFrame.new(0, -2.5 * scale, 0)

    for _, part in pairs({hilt, guard}) do
        local weld = Instance.new("WeldConstraint", blade); weld.Part0 = blade; weld.Part1 = part
        part.Anchored = false
    end
    return model
end

local function PlaySound(id, vol, pitch)
    local s = Instance.new("Sound", workspace)
    s.SoundId = "rbxassetid://" .. tostring(id); s.Volume = vol or 2; s.Pitch = pitch or 1
    s:Play(); Debris:AddItem(s, 10)
end

local function SetPose(char, state)
    if not char:FindFirstChild("RightUpperArm") then return end 
    local rArm = char.RightUpperArm:FindFirstChild("RightShoulder")
    local rLeg = char.RightUpperLeg:FindFirstChild("RightHip")
    if state then
        if rArm then 
            originalJoints.rArm = rArm.C0
            TweenService:Create(rArm, TweenInfo.new(0.5), {C0 = originalJoints.rArm * CFrame.Angles(math.rad(90), math.rad(-45), 0)}):Play()
        end
        if rLeg then
            originalJoints.rLeg = rLeg.C0
            TweenService:Create(rLeg, TweenInfo.new(0.5), {C0 = originalJoints.rLeg * CFrame.Angles(math.rad(30), 0, 0)}):Play()
        end
    else
        if rArm and originalJoints.rArm then rArm.C0 = originalJoints.rArm end
        if rLeg and originalJoints.rLeg then rLeg.C0 = originalJoints.rLeg end
        originalJoints = {}
    end
end

-- ==========================================
-- CHIÊU THỨC: BIẾN HÌNH DIỆT THẾ
-- ==========================================
TabSword:CreateButton({
    Name = "Nhận: ⚔️ Ấn Ký Kiếm Đạo",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name = "⚔️ Biến Hình"; tool.RequiresHandle = false
        
        tool.Activated:Connect(function()
            local char = player.Character
            if not char or SwordState.IsTransformed or tick() - SwordState.LastCastTime < SwordState.Cooldown then return end
            
            SwordState.LastCastTime = tick(); SwordState.IsTransformed = true
            local root = char.HumanoidRootPart; local hum = char.Humanoid; local startPos = root.Position
            hum.WalkSpeed = 0; hum.JumpPower = 0; root.Anchored = true
            
            -- [1] MẶT ĐẤT HÓA ĐEN (200x200)
            local darkGround = Instance.new("Part", workspace)
            darkGround.Size = Vector3.new(200, 1, 200); darkGround.CFrame = CFrame.new(startPos - Vector3.new(0, 2.9, 0))
            darkGround.Color = Color3.new(0, 0, 0); darkGround.Material = Enum.Material.Neon; darkGround.Anchored = true; darkGround.CanCollide = false
            darkGround.Transparency = 1
            TweenService:Create(darkGround, TweenInfo.new(1), {Transparency = 0.5}):Play()
            Debris:AddItem(darkGround, 15)

            -- [2] KIẾM TRỒI LÊN VÀ RUNG LẮC (3 GIÂY)
            local tempSwords = {}
            PlaySound(142070127, 2, 0.4) -- Tiếng vọng u ám
            for i = 1, 40 do
                local s = BuildSword(0.8, false)
                s.Parent = workspace
                local offset = Vector3.new(math.random(-30, 30), -6, math.random(-30, 30))
                s.PrimaryPart.CFrame = CFrame.new(startPos + offset) * CFrame.Angles(math.rad(180), math.random(-1, 1), 0)
                table.insert(tempSwords, s)
                
                -- Tween nhích lên khỏi mặt đất
                TweenService:Create(s.PrimaryPart, TweenInfo.new(2, Enum.EasingStyle.Sine), {CFrame = s.PrimaryPart.CFrame * CFrame.new(0, 5, 0)}):Play()
            end

            -- Hiệu ứng rung chuyển
            local shakeConn = RunService.Heartbeat:Connect(function()
                for _, s in pairs(tempSwords) do
                    s.PrimaryPart.CFrame = s.PrimaryPart.CFrame * CFrame.Angles(math.rad(math.random(-2, 2)), math.rad(math.random(-2, 2)), 0)
                end
            end)
            PlaySound(5094957444, 2, 0.8) -- Tiếng kim loại rung
            task.wait(3)
            shakeConn:Disconnect()

            -- [3] KIẾM BAY XOAY QUANH VÀ PHÓNG LÊN CAO
            PlaySound(4446671048, 2, 1) -- Tiếng xé gió
            for _, s in pairs(tempSwords) do
                task.spawn(function()
                    TweenService:Create(s.PrimaryPart, TweenInfo.new(0.5, Enum.EasingStyle.Back), {CFrame = root.CFrame * CFrame.Angles(0, math.random(0, 360), 0) * CFrame.new(0, 0, 10)}):Play()
                    task.wait(0.5)
                    TweenService:Create(s.PrimaryPart, TweenInfo.new(0.8, Enum.EasingStyle.Exponential), {CFrame = root.CFrame * CFrame.new(0, 150, 5)}):Play()
                end)
            end
            
            task.wait(1)
            root.CFrame = root.CFrame * CFrame.new(0, 150, 0)
            SetPose(char, true)
            
            -- [4] KIẾM TRẬN SAU LƯNG VÀ PHÓNG XUỐNG 60 ĐỘ
            local swordCircle = {}
            for i = 1, 20 do
                local s = BuildSword(0.7, true)
                s.Parent = workspace; table.insert(swordCircle, s)
                local angle = math.rad(i * (360/20))
                s.PrimaryPart.CFrame = root.CFrame * CFrame.new(math.cos(angle) * 12, math.sin(angle) * 12, 5) * CFrame.Angles(math.rad(-60), 0, 0)
            end

            task.wait(1.5)
            PlaySound(864568856, 3, 1.5) -- Tiếng bộc phá
            for _, s in pairs(swordCircle) do
                task.spawn(function()
                    local targetPos = s.PrimaryPart.CFrame * CFrame.new(0, -300, 0)
                    local tw = TweenService:Create(s.PrimaryPart, TweenInfo.new(1.5, Enum.EasingStyle.Linear), {CFrame = targetPos})
                    tw:Play()
                    tw.Completed:Wait()
                    s:Destroy()
                end)
                task.wait(0.05)
            end
            
            for _, s in pairs(tempSwords) do s:Destroy() end

            -- [5] 3 THANH KIẾM HỘ THỂ
            SetPose(char, false); root.Anchored = false
            hum.WalkSpeed = 50; hum.JumpPower = 60
            
            local swordPos = {
                {off = CFrame.new(-3, 2, 0) * CFrame.Angles(math.rad(180), 0, 0), sc = 1.2},
                {off = CFrame.new(3, 2, 0) * CFrame.Angles(math.rad(180), 0, 0), sc = 1.2},
                {off = CFrame.new(0, 1, 2) * CFrame.Angles(math.rad(45), 0, math.rad(-45)), sc = 1.5}
            }
            
            for _, p in ipairs(swordPos) do
                local gs = BuildSword(p.sc, true)
                gs.Parent = workspace; gs.PrimaryPart.Anchored = false
                local w = Instance.new("Weld", gs.PrimaryPart); w.Part0 = root; w.Part1 = gs.PrimaryPart; w.C0 = p.off
                table.insert(SwordState.GuardianSwords, gs)
            end

            RunService:BindToRenderStep("SpinSwords", 200, function()
                if SwordState.GuardianSwords[1] and SwordState.GuardianSwords[2] then
                    SwordState.GuardianSwords[1].PrimaryPart.Weld.C0 *= CFrame.Angles(0, math.rad(5), 0)
                    SwordState.GuardianSwords[2].PrimaryPart.Weld.C0 *= CFrame.Angles(0, math.rad(5), 0)
                end
            end)
            Rayfield:Notify({Title = "Thành Công", Content = "Kiếm Đạo Diệt Thế đã sẵn sàng!", Duration = 3})
        end)
    end
})

TabSword:CreateButton({
    Name = "🧹 Thu Kiếm (Hủy Dạng)",
    Callback = function()
        SwordState.IsTransformed = false
        RunService:UnbindFromRenderStep("SpinSwords")
        for _, s in pairs(SwordState.GuardianSwords) do if s then s:Destroy() end end
        SwordState.GuardianSwords = {}
        local char = player.Character
        if char then
            char.Humanoid.WalkSpeed = 16; char.Humanoid.JumpPower = 50
            SetPose(char, false); char.HumanoidRootPart.Anchored = false
        end
    end
})
