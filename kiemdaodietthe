    local txt = Instance.new("TextLabel", bgui); txt.Size = UDim2.new(1, 0, 1, 0); txt.BackgroundTransparency = 1; txt.Text = textName; txt.TextColor3 = color; txt.Font = Enum.Font.GothamBold; txt.TextScaled = true; table.insert(VisionState.ESPs, bgui)
end

