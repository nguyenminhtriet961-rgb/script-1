local function BuildSword(scale, isGlowing, hasDarkAura)
    local model = Instance.new("Model")
    local blade = Instance.new("Part")
    blade.Name = "Blade"; blade.Size = Vector3.new(0.1 * scale, 5 * scale, 0.4 * scale)
    blade.Color = Color3.fromRGB(255, 255, 255); blade.Material = isGlowing and Enum.Material.Neon or Enum.Material.Metal
    blade.Anchored = true; blade.CanCollide = false; blade.Parent = model
    model.PrimaryPart = blade
    
    local tip = Instance.new("WedgePart")
    tip.Size = Vector3.new(0.1 * scale, 1 * scale, 0.4 * scale); tip.Color = blade.Color; tip.Anchored = false; tip.CanCollide = false
    tip.CFrame = blade.CFrame * CFrame.new(0, 3 * scale, 0); tip.Parent = model
    local wTip = Instance.new("WeldConstraint", blade); wTip.Part0 = blade; wTip.Part1 = tip
    
    local hilt = Instance.new("Part")
    hilt.Size = Vector3.new(0.2 * scale, 1.2 * scale, 0.2 * scale); hilt.Color = Color3.fromRGB(30, 20, 10); hilt.Anchored = false; hilt.Parent = model
    hilt.CFrame = blade.CFrame * CFrame.new(0, -3.1 * scale, 0)
    local wHilt = Instance.new("WeldConstraint", blade); wHilt.Part0 = blade; wHilt.Part1 = hilt

    if hasDarkAura then
        local p = Instance.new("ParticleEmitter", blade)
        p.Color = ColorSequence.new(Color3.new(0,0,0), Color3.new(0.6,0,0)); p.Size = NumberSequence.new(2,0)
        p.Texture = "rbxassetid://243660364"; p.Rate = 40; p.Lifetime = NumberRange.new(0.5, 0.8)
    end
    return model
end

local function PlaySound(id, vol, pitch, parent)
    local s = Instance.new("Sound", parent or workspace)
    s.SoundId = "rbxassetid://" .. tostring(id); s.Volume = vol or 2; s.Pitch = pitch or 1
    s:Play(); Debris:AddItem(s, 15)
    return s
end

local function MorphDemon(char, state)
    if not char then return end
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
            if state then
                if not v:GetAttribute("OldCol") then v:SetAttribute("OldCol", v.Color) end
                v.Color = Color3.new(0,0,0)
            else
                v.Color = v:GetAttribute("OldCol") or v.Color
            end
        elseif v:IsA("Decal") or v:IsA("Accessory") then
            v.Transparency = state and 1 or 0
        end
    end

    if state then
        local eye = Instance.new("Part", char)
        eye.Name = "DemonEye"; eye.Size = Vector3.new(0.4, 0.2, 0.1); eye.Color = Color3.new(1, 0, 0); eye.Material = Enum.Material.Neon
        eye.Anchored = false; eye.CanCollide = false
        local w = Instance.new("Weld", eye); w.Part0 = char:FindFirstChild("Head"); w.Part1 = eye; w.C0 = CFrame.new(0, 0.2, -0.6)
        local trail = Instance.new("Trail", eye)
        trail.Color = ColorSequence.new(Color3.new(1, 0, 0)); trail.Lifetime = 0.5; trail.Attachment0 = Instance.new("Attachment", eye); trail.Attachment1 = Instance.new("Attachment", eye)
        trail.Attachment1.Position = Vector3.new(0, 0.2, 0)
    else
        if char:FindFirstChild("DemonEye") then char.DemonEye:Destroy() end
    end
end

