    if not target or not target.PrimaryPart then return end
    local hl = Instance.new("Highlight", target); hl.FillColor = color; hl.OutlineColor = Color3.new(1,1,1); hl.FillTransparency = 0.5; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; table.insert(VisionState.ESPs, hl)
