local function BuildSword(scale, isGlowing, hasDarkAura)
    local model = Instance.new("Model")
    local blade = Instance.new("Part", model)
    blade.Name = "Blade"; blade.Size = Vector3.new(0.1 * scale, 5 * scale, 0.4 * scale)
    blade.Color = Color3.fromRGB(255, 255, 255); blade.Material = isGlowing and Enum.Material.Neon or Enum.Material.Metal
    blade.Anchored = true; blade.CanCollide = false; model.PrimaryPart = blade
    
    local tip = Instance.new("WedgePart", model)
    tip.Size = Vector3.new(0.1 * scale, 1 * scale, 0.4 * scale); tip.Color = blade.Color; tip.Anchored = false; tip.CanCollide = false
    tip.CFrame = blade.CFrame * CFrame.new(0, 3 * scale, 0)
    Instance.new("WeldConstraint", blade).Part0 = blade; Instance.new("WeldConstraint", blade).Part1 = tip; tip.Parent = model
    
    local hilt = Instance.new("Part", model)
    hilt.Size = Vector3.new(0.2 * scale, 1.2 * scale, 0.2 * scale); hilt.Color = Color3.fromRGB(30, 20, 10); hilt.Material = Enum.Material.Fabric
    hilt.Anchored = false; hilt.CanCollide = false; hilt.CFrame = blade.CFrame * CFrame.new(0, -3.1 * scale, 0)
    Instance.new("WeldConstraint", blade).Part0 = blade; Instance.new("WeldConstraint", blade).Part1 = hilt; hilt.Parent = model

    if hasDarkAura then
        local p = Instance.new("ParticleEmitter", blade)
        p.Color = ColorSequence.new(Color3.new(0,0,0), Color3.new(0.5,0,0)); p.Size = NumberSequence.new(2,0)
        p.Texture = "rbxassetid://243660364"; p.Rate = 30; p.Lifetime = NumberRange.new(0.5)
    end
    return model
end

local function PlaySound(id, vol, pitch)
    local s = Instance.new("Sound", workspace)
    s.SoundId = "rbxassetid://" .. tostring(id); s.Volume = vol or 2; s.Pitch = pitch or 1
    s:Play(); Debris:AddItem(s, 10)
    return s
end

local function MorphDemon(char, state)
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
            v.Color = state and Color3.new(0,0,0) or (v:GetAttribute("OldCol") or v.Color)
            if state and not v:GetAttribute("OldCol") then v:SetAttribute("OldCol", v.Color) end
        elseif v:IsA("Decal") then v.Transparency = state and 1 or 0 end
    end
end

