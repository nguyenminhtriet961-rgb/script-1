local function BuildSword(scale, isGlowing, hasDarkAura)
    local model = Instance.new("Model")
    local blade = Instance.new("Part", model)
    blade.Name = "Blade"; blade.Size = Vector3.new(0.1 * scale, 5 * scale, 0.4 * scale)
    blade.Color = Color3.fromRGB(255, 255, 255); blade.Material = isGlowing and Enum.Material.Neon or Enum.Material.Metal
    blade.Anchored = true; blade.CanCollide = false; model.PrimaryPart = blade
    
    local tip = Instance.new("WedgePart", model)
    tip.Size = Vector3.new(0.1 * scale, 1 * scale, 0.4 * scale); tip.Color = blade.Color; tip.Material = blade.Material
    tip.Anchored = false; tip.CanCollide = false; tip.CFrame = blade.CFrame * CFrame.new(0, 3 * scale, 0)
    local wTip = Instance.new("WeldConstraint", blade); wTip.Part0 = blade; wTip.Part1 = tip
    
    local hilt = Instance.new("Part", model)
    hilt.Size = Vector3.new(0.2 * scale, 1.2 * scale, 0.2 * scale); hilt.Color = Color3.fromRGB(20, 10, 5); hilt.Material = Enum.Material.Fabric
    hilt.Anchored = false; hilt.CanCollide = false; hilt.CFrame = blade.CFrame * CFrame.new(0, -3.1 * scale, 0)
    local wHilt = Instance.new("WeldConstraint", blade); wHilt.Part0 = blade; wHilt.Part1 = hilt
    
    local guard = Instance.new("Part", model)
    guard.Size = Vector3.new(0.3 * scale, 0.1 * scale, 0.5 * scale); guard.Color = Color3.fromRGB(10, 10, 10); guard.Material = Enum.Material.Metal
    guard.Anchored = false; guard.CanCollide = false; guard.CFrame = blade.CFrame * CFrame.new(0, -2.5 * scale, 0)
    local wGuard = Instance.new("WeldConstraint", blade); wGuard.Part0 = blade; wGuard.Part1 = guard

    if hasDarkAura then
        local aura = Instance.new("ParticleEmitter", blade)
        aura.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 0, 50))
        aura.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.5 * scale), NumberSequenceKeypoint.new(1, 0)})
        aura.Texture = "rbxassetid://243660364" 
        aura.Rate = 50; aura.Speed = NumberRange.new(1, 3); aura.Lifetime = NumberRange.new(0.5, 1)
    end
    return model
end

local function BuildRidingSword()
    local model = Instance.new("Model")
    local core = Instance.new("Part", model)
    core.Name = "Core"; core.Size = Vector3.new(0.1, 6, 0.4)
    core.Color = Color3.fromRGB(15, 15, 15); core.Material = Enum.Material.Slate
    core.Anchored = true; core.CanCollide = false; model.PrimaryPart = core

    local edge1 = Instance.new("Part", model)
    edge1.Size = Vector3.new(0.05, 6.2, 0.1); edge1.Color = Color3.fromRGB(255, 255, 255); edge1.Material = Enum.Material.Neon
    edge1.CFrame = core.CFrame * CFrame.new(0, 0, 0.25); edge1.Anchored = false; edge1.CanCollide = false
    local w1 = Instance.new("WeldConstraint", core); w1.Part0 = core; w1.Part1 = edge1

    local edge2 = Instance.new("Part", model)
    edge2.Size = Vector3.new(0.05, 6.2, 0.1); edge2.Color = Color3.fromRGB(255, 255, 255); edge2.Material = Enum.Material.Neon
    edge2.CFrame = core.CFrame * CFrame.new(0, 0, -0.25); edge2.Anchored = false; edge2.CanCollide = false
    local w2 = Instance.new("WeldConstraint", core); w2.Part0 = core; w2.Part1 = edge2

    local tipLeft = Instance.new("WedgePart", model)
    tipLeft.Size = Vector3.new(0.1, 1.5, 0.2); tipLeft.Color = Color3.fromRGB(255, 255, 255); tipLeft.Material = Enum.Material.Neon
    tipLeft.CFrame = core.CFrame * CFrame.new(0, 3.75, 0.1); tipLeft.Anchored = false; tipLeft.CanCollide = false
    local wtl = Instance.new("WeldConstraint", core); wtl.Part0 = core; wtl.Part1 = tipLeft

    local tipRight = Instance.new("WedgePart", model)
    tipRight.Size = Vector3.new(0.1, 1.5, 0.2); tipRight.Color = Color3.fromRGB(255, 255, 255); tipRight.Material = Enum.Material.Neon
    tipRight.CFrame = core.CFrame * CFrame.new(0, 3.75, -0.1) * CFrame.Angles(0, math.rad(180), 0); tipRight.Anchored = false; tipRight.CanCollide = false
    local wtr = Instance.new("WeldConstraint", core); wtr.Part0 = core; wtr.Part1 = tipRight

    local cross = Instance.new("Part", model)
    cross.Size = Vector3.new(0.3, 0.4, 1.5); cross.Color = Color3.fromRGB(90, 50, 25); cross.Material = Enum.Material.Wood
    cross.CFrame = core.CFrame * CFrame.new(0, -3.2, 0); cross.Anchored = false; cross.CanCollide = false
    local wc = Instance.new("WeldConstraint", core); wc.Part0 = core; wc.Part1 = cross

    local hilt = Instance.new("Part", model)
    hilt.Size = Vector3.new(0.2, 1.5, 0.2); hilt.Color = Color3.fromRGB(50, 30, 15); hilt.Material = Enum.Material.Wood
    hilt.CFrame = core.CFrame * CFrame.new(0, -4.1, 0); hilt.Anchored = false; hilt.CanCollide = false
    local wh = Instance.new("WeldConstraint", core); wh.Part0 = core; wh.Part1 = hilt

    local smoke = Instance.new("ParticleEmitter", core)
    smoke.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))})
    smoke.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 4)})
    smoke.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
    smoke.Lifetime = NumberRange.new(3, 3); smoke.Rate = 100; smoke.Speed = NumberRange.new(0)
    smoke.Texture = "rbxassetid://243660364"

    return model
end

local function QuadBezier(t, p0, p1, p2) return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2 end

