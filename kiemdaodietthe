TabVision:CreateButton({
    Name = "👁️ Bật: Mắt Âm (Vạn Vật ESP + Tăng Hitbox)",
    Callback = function()
        if VisionState.YinActive then return end
        VisionState.YinActive = true
        if VisionState.YangActive then VisionState.YangActive = false; ClearVision() end
        
        CreateWave(Color3.fromRGB(255, 0, 0)) -- Vòng tròn đỏ
        PlaySound(4446671048, 2, 0.8)
        
        -- Thuật toán quét vạn vật và tăng hitbox
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj ~= player.Character then
                local isPlayer = Players:GetPlayerFromCharacter(obj)
                local hasHum = obj:FindFirstChild("Humanoid")
                local root = obj:FindFirstChild("HumanoidRootPart")
                
                if isPlayer then
                    -- Người chơi (Màu Đỏ)
                    CreateESP(obj, Color3.fromRGB(255, 50, 50), "Người: " .. isPlayer.Name)
                    if root then
                        VisionState.Hitboxes[obj] = root.Size
                        root.Size = Vector3.new(15, 15, 15)
                        root.Transparency = 0.5
                        root.CanCollide = false
                    end
                elseif hasHum then
                    -- NPC (Màu Xanh lục)
                    CreateESP(obj, Color3.fromRGB(50, 255, 50), "NPC: " .. obj.Name)
                    if root then
                        VisionState.Hitboxes[obj] = root.Size
                        root.Size = Vector3.new(15, 15, 15)
                        root.Transparency = 0.5
                        root.CanCollide = false
                    end
                end
            elseif obj:IsA("Tool") then
                -- Vật phẩm (Màu Nâu)
                CreateESP(obj, Color3.fromRGB(139, 69, 19), "Đồ vật: " .. obj.Name)
            elseif obj:IsA("Part") and obj.Name == "DroppedItem" then
                -- Thể loại vật thể khác (Trắng)
                CreateESP(obj, Color3.fromRGB(255, 255, 255), "Vật thể")
            end
        end
        Rayfield:Notify({Title = "Mắt Âm", Content = "Đã bật ESP Vạn Vật & Phóng to Hitbox.", Duration = 3})
    end
})

