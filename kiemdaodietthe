local function CreateRift(cframe)
    local rift = Instance.new("Part", workspace)
    rift.Size = Vector3.new(8, 10, 1) -- To gấp rưỡi nhân vật
    rift.CFrame = cframe
    rift.Shape = Enum.PartType.Cylinder
    rift.Color = Color3.new(0, 0, 0)
    rift.Material = Enum.Material.Neon
    rift.Anchored = true; rift.CanCollide = false
    
    local hl = Instance.new("Highlight", rift)
    hl.FillColor = Color3.new(0,0,0); hl.OutlineColor = Color3.fromRGB(150, 0, 255)
    
    -- Xoay dẹp lại thành hình bầu dục
    local mesh = Instance.new("BlockMesh", rift)
    mesh.Scale = Vector3.new(1, 1, 0.1)
    
    local aura = Instance.new("ParticleEmitter", rift)
    aura.Color = ColorSequence.new(Color3.fromRGB(150, 0, 255))
    aura.Size = NumberSequence.new(2, 0)
    aura.Rate = 100; aura.Speed = NumberRange.new(5)
    aura.Lifetime = NumberRange.new(0.5, 1)

    Debris:AddItem(rift, 5) -- Tồn tại 5 giây
    return rift
end

TabSword:CreateButton({
    Name = "Lấy Vật Phẩm: 🗡️ Hư Không Trảm",
    Callback = function()
        if player.Backpack:FindFirstChild("🗡️ Hư Không Trảm") or (player.Character and player.Character:FindFirstChild("🗡️ Hư Không Trảm")) then return end
        local tool = Instance.new("Tool"); tool.Name = "🗡️ Hư Không Trảm"; tool.RequiresHandle = false; tool.Parent = player.Backpack

        tool.Activated:Connect(function()
            local char = player.Character; local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root or not SwordState.IsTransformed or #SwordState.GuardianSwords < 3 then 
                Rayfield:Notify({Title = "Lỗi", Content = "Phải bật Diệt Thế để có 3 thanh kiếm mới dùng được!", Duration = 3})
                return 
            end
            
            -- Tổng thời gian 1.5 giây
            RunService:UnbindFromRenderStep("SpinSwords")
            char.Humanoid.WalkSpeed = 0
            
            local s1 = SwordState.GuardianSwords[1].PrimaryPart
            local s2 = SwordState.GuardianSwords[2].PrimaryPart
            local s3 = SwordState.GuardianSwords[3].PrimaryPart

            -- 1. Chém 3 nhát
            PlaySound(138080210, 3, 1)
            TweenService:Create(s1.Weld, TweenInfo.new(0.3), {C0 = CFrame.new(-3, 0, -5) * CFrame.Angles(math.rad(45), math.rad(90), 0)}):Play()
            TweenService:Create(s2.Weld, TweenInfo.new(0.3), {C0 = CFrame.new(3, 0, -5) * CFrame.Angles(math.rad(-45), math.rad(90), 0)}):Play()
            TweenService:Create(s3.Weld, TweenInfo.new(0.3), {C0 = CFrame.new(0, 0, -5) * CFrame.Angles(math.rad(90), 0, 0)}):Play()
            
            -- Vệt chém (Part Neon mỏng)
            for i = 1, 3 do
                local slash = Instance.new("Part", workspace)
                slash.Size = Vector3.new(0.2, 15, 0.2); slash.Material = Enum.Material.Neon; slash.Color = Color3.fromRGB(255, 255, 255)
                slash.Anchored = true; slash.CanCollide = false
                slash.CFrame = root.CFrame * CFrame.new(0, 0, -6) * CFrame.Angles(0, 0, math.rad(math.random(-60, 60)))
                TweenService:Create(slash, TweenInfo.new(0.5), {Transparency = 1, Size = Vector3.new(0, 20, 0)}):Play()
                Debris:AddItem(slash, 0.5)
            end

            task.wait(0.5)

            -- 2. Nổ và tạo Vết Nứt
            PlaySound(864568856, 4, 1.2)
            local riftPos1 = root.CFrame * CFrame.new(0, 0, -5)
            CreateRift(riftPos1)

            -- 3. Raycast dò đường 85m
            local rayParams = RaycastParams.new(); rayParams.FilterDescendantsInstances = {char}; rayParams.FilterType = Enum.RaycastFilterType.Exclude
            local rayResult = workspace:Raycast(root.Position, root.CFrame.LookVector * 85, rayParams)
            
            local destPos
            if rayResult then
                destPos = rayResult.Position - (root.CFrame.LookVector * 5) -- Dừng trước tường 5m
            else
                destPos = root.Position + (root.CFrame.LookVector * 85)
            end
            
            local riftPos2 = CFrame.new(destPos, destPos + root.CFrame.LookVector)
            CreateRift(riftPos2)

            -- 4. Dịch chuyển (Ép đi vào vết nứt)
            TweenService:Create(root, TweenInfo.new(0.3), {CFrame = riftPos1}):Play()
            task.wait(0.3)
            
            for _, v in pairs(char:GetDescendants()) do if v:IsA("BasePart") then v.Transparency = 1 end end
            root.CFrame = riftPos2 * CFrame.new(0,0,2)
            task.wait(0.2)
            
            PlaySound(138080210, 2, 1.5)
            for _, v in pairs(char:GetDescendants()) do if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then v.Transparency = 0 end end
            TweenService:Create(root, TweenInfo.new(0.2), {CFrame = riftPos2 * CFrame.new(0,0,-5)}):Play()

            -- Trả lại kiếm
            task.wait(0.3)
            char.Humanoid.WalkSpeed = 50
            local swordPos = { {off = CFrame.new(-4, 3, 0) * CFrame.Angles(math.rad(180), 0, 0)}, {off = CFrame.new(4, 3, 0) * CFrame.Angles(math.rad(180), 0, 0)}, {off = CFrame.new(0, 1, 3) * CFrame.Angles(math.rad(45), 0, math.rad(-45))} }
            TweenService:Create(s1.Weld, TweenInfo.new(0.5), {C0 = swordPos[1].off}):Play()
            TweenService:Create(s2.Weld, TweenInfo.new(0.5), {C0 = swordPos[2].off}):Play()
            TweenService:Create(s3.Weld, TweenInfo.new(0.5), {C0 = swordPos[3].off}):Play()
            
            RunService:BindToRenderStep("SpinSwords", 200, function()
                if SwordState.GuardianSwords[1] and SwordState.GuardianSwords[2] then
                    s1.Weld.C0 *= CFrame.Angles(0, math.rad(3), 0)
                    s2.Weld.C0 *= CFrame.Angles(0, math.rad(3), 0)
                end
            end)
        end)
    end
})

