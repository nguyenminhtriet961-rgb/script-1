local function ClearVision()
    for _, esp in pairs(VisionState.ESPs) do if esp then esp:Destroy() end end
    VisionState.ESPs = {}
    for char, size in pairs(VisionState.Hitboxes) do
        if char and char:FindFirstChild("HumanoidRootPart") then char.HumanoidRootPart.Size = size; char.HumanoidRootPart.Transparency = 1; char.HumanoidRootPart.CanCollide = true end
    end
    VisionState.Hitboxes = {}
    Lighting.Ambient = VisionState.OriginalLighting.Ambient; Lighting.GlobalShadows = VisionState.OriginalLighting.GlobalShadows; Lighting.Brightness = VisionState.OriginalLighting.Brightness; Lighting.OutdoorAmbient = VisionState.OriginalLighting.OutdoorAmbient
end

