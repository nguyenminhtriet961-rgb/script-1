-- ==========================================
-- HÀM HỖ TRỢ: TẠO KIẾM & KỸ XẢO HẠT
-- ==========================================
local function BuildSword(scale, isGlowing, hasDarkAura)
    local model = Instance.new("Model")
    
    local blade = Instance.new("Part", model)
    blade.Name = "Blade"; blade.Size = Vector3.new(0.1 * scale, 5 * scale, 0.4 * scale)
    blade.Color = Color3.fromRGB(255, 255, 255); blade.Material = isGlowing and Enum.Material.Neon or Enum.Material.Metal
    blade.Anchored = true; blade.CanCollide = false; model.PrimaryPart = blade
    
    local tip = Instance.new("WedgePart", model)
    tip.Size = Vector3.new(0.1 * scale, 1 * scale, 0.4 * scale); tip.Color = blade.Color; tip.Material = blade.Material
    tip.Anchored = false; tip.CanCollide = false; tip.CFrame = blade.CFrame * CFrame.new(0, 3 * scale, 0)
    local wTip = Instance.new("WeldConstraint", blade); wTip.Part0 = blade; wTip.Part1 = tip
    
    local hilt = Instance.new("Part", model)
    hilt.Size = Vector3.new(0.2 * scale, 1.2 * scale, 0.2 * scale); hilt.Color = Color3.fromRGB(20, 10, 5); hilt.Material = Enum.Material.Fabric
    hilt.Anchored = false; hilt.CanCollide = false; hilt.CFrame = blade.CFrame * CFrame.new(0, -3.1 * scale, 0)
    local wHilt = Instance.new("WeldConstraint", blade); wHilt.Part0 = blade; wHilt.Part1 = hilt
    
    local guard = Instance.new("Part", model)
    guard.Size = Vector3.new(0.3 * scale, 0.1 * scale, 0.5 * scale); guard.Color = Color3.fromRGB(10, 10, 10); guard.Material = Enum.Material.Metal
    guard.Anchored = false; guard.CanCollide = false; guard.CFrame = blade.CFrame * CFrame.new(0, -2.5 * scale, 0)
    local wGuard = Instance.new("WeldConstraint", blade); wGuard.Part0 = blade; wGuard.Part1 = guard

    if hasDarkAura then
        local aura = Instance.new("ParticleEmitter", blade)
        aura.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 0, 50))
        aura.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.5 * scale), NumberSequenceKeypoint.new(1, 0)})
        aura.Texture = "rbxassetid://243660364" 
        aura.Rate = 50; aura.Speed = NumberRange.new(1, 3); aura.Lifetime = NumberRange.new(0.5, 1)
        aura.Rotation = NumberRange.new(0, 360); aura.RotSpeed = NumberRange.new(100, 200)
    end
    return model
end

local function AddBodyAura(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local aura = Instance.new("ParticleEmitter", root)
    aura.Name = "MinTAura"
    aura.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(200, 0, 0))
    aura.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 0)})
    aura.Texture = "rbxassetid://243660364" 
    aura.Rate = 150; aura.Speed = NumberRange.new(2, 6); aura.Lifetime = NumberRange.new(0.5, 1.2)
    aura.Rotation = NumberRange.new(0, 360); aura.RotSpeed = NumberRange.new(200, 400)
    aura.ZOffset = -1
    return aura
end

local function PlaySound(id, vol, pitch, parent)
    local s = Instance.new("Sound", parent or workspace)
    s.SoundId = "rbxassetid://" .. tostring(id); s.Volume = vol or 2; s.Pitch = pitch or 1
    s:Play(); Debris:AddItem(s, 12)
    return s
end

-- ==========================================
-- HÀM BẺ POSE CƯỜNG GIẢ (R15)
-- ==========================================
local function SetPose(char, state)
    if not char:FindFirstChild("RightUpperArm") then return end 
    local joints = {
        rShoulder = char.RightUpperArm:FindFirstChild("RightShoulder"),
        lShoulder = char.LeftUpperArm:FindFirstChild("LeftShoulder"),
        rHip = char.RightUpperLeg:FindFirstChild("RightHip"),
        neck = char.Head:FindFirstChild("Neck")
    }
    if state then
        for name, joint in pairs(joints) do if joint then originalJoints[name] = joint.C0 end end
        if joints.rShoulder then TweenService:Create(joints.rShoulder, TweenInfo.new(1), {C0 = joints.rShoulder.C0 * CFrame.Angles(math.rad(45), math.rad(-60), math.rad(30))}):Play() end
        if joints.lShoulder then TweenService:Create(joints.lShoulder, TweenInfo.new(1), {C0 = joints.lShoulder.C0 * CFrame.Angles(math.rad(45), math.rad(60), math.rad(-30))}):Play() end
        if joints.rHip then TweenService:Create(joints.rHip, TweenInfo.new(1), {C0 = joints.rHip.C0 * CFrame.Angles(math.rad(40), 0, 0)}):Play() end
        if joints.neck then TweenService:Create(joints.neck, TweenInfo.new(1), {C0 = joints.neck.C0 * CFrame.Angles(math.rad(20), 0, 0)}):Play() end
    else
        for name, joint in pairs(joints) do if joint and originalJoints[name] then joint.C0 = originalJoints[name] end end
        originalJoints = {}
    end
end

-- ==========================================
-- CHIÊU THỨC: BIẾN HÌNH DIỆT THẾ
-- ==========================================
TabSword:CreateButton({
