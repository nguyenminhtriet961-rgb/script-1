 
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
    Name = "ma thần Thời Gian Hub ⏳",
    LoadingTitle = "Hệ thống Thời Gian...",
    LoadingSubtitle = "Script xịn hơn rồi đấy chị!",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local TabTime = Window:CreateTab("⏳ Ma Thần", nil)

-- ==========================================
-- QUẢN LÝ TRẠNG THÁI (STATE MACHINE TỐI ƯU)
-- ==========================================
local TimeState = {
    IsTransformed = false,
    ActiveSkill = nil, -- Khóa chiêu: "None", "TimeStop", "Rewind", "Dash"
    
    -- Dành cho hệ thống Quay ngược
    History = {},
    MaxRecordTime = 15,
    RewindSeconds = 5,
    IsRecording = false
}

-- Vòng lặp ghi hình quá khứ (Chỉ chạy khi đã biến hình)
local recordConn
local function StartRecording()
    if recordConn then recordConn:Disconnect() end
    TimeState.History = {}
    TimeState.IsRecording = true
    
    recordConn = RunService.Heartbeat:Connect(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and TimeState.IsRecording then
            local root = char.HumanoidRootPart
            table.insert(TimeState.History, { Time = tick(), CF = root.CFrame })
            
            -- Xóa dữ liệu cũ hơn MaxRecordTime để tránh tràn RAM
            while #TimeState.History > 0 and (tick() - TimeState.History[1].Time) > TimeState.MaxRecordTime do
                table.remove(TimeState.History, 1)
            end
        end
    end)
end

-- ==========================================
-- UI MENU & KỸ NĂNG
-- ==========================================

TabTime:CreateSlider({
    Name = "Thời gian quay ngược (Giây)",
    Range = {1, 15},
    Increment = 1,
    Suffix = "Giây",
    CurrentValue = 5,
    Flag = "RewindSlider",
    Callback = function(Value)
        TimeState.RewindSeconds = Value
    end,
})

TabTime:CreateButton({
    Name = "Nhận: ⏳ Ấn Ký (Biến Hình)",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏳ Biến Hình", false
        
        tool.Activated:Connect(function()
            if TimeState.ActiveSkill and TimeState.ActiveSkill ~= "Transform" then
                Rayfield:Notify({Title = "Bị khóa", Content = "Đang dùng chiêu khác, hãy tắt trước!", Duration = 2})
                return
            end
            
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            
            if TimeState.IsTransformed then
                Rayfield:Notify({Title = "Thông báo", Content = "Đã biến hình rồi!", Duration = 2})
                return
            end
            
            TimeState.ActiveSkill = "Transform"
            TimeState.IsTransformed = true
            
            -- Hiệu ứng cơ bản
            char.Humanoid.WalkSpeed = 50
            StartRecording() -- Bắt đầu ghi hình quá khứ
            
            Rayfield:Notify({Title = "Thức tỉnh!", Content = "Đã bật Hệ thống Thời Gian!", Duration = 3})
            TimeState.ActiveSkill = nil -- Mở khóa cho chiêu khác
        end)
    end
})

TabTime:CreateButton({
    Name = "Nhận: ⏸️ Ngưng Đọng",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏸️ Ngưng Đọng", false
        local isStopped = false
        
        tool.Activated:Connect(function()
            if not TimeState.IsTransformed then return end
            
            -- NẾU ĐANG CHẠY CHIÊU KHÁC (trừ chính chiêu này) THÌ CHẶN
            if TimeState.ActiveSkill and TimeState.ActiveSkill ~= "TimeStop" then
                Rayfield:Notify({Title = "Khóa Chiêu", Content = "Phải tắt chiêu hiện tại mới dùng được!", Duration = 2})
                return
            end

            if isStopped then
                -- Tắt Ngưng đọng
                isStopped = false
                TimeState.ActiveSkill = nil -- Trả lại trạng thái rảnh
                Rayfield:Notify({Title = "Giải trừ", Content = "Thời gian trôi trở lại.", Duration = 2})
                -- Thêm logic unanchor người chơi khác ở đây
            else
                -- Bật Ngưng đọng
                isStopped = true
                TimeState.ActiveSkill = "TimeStop" -- Khóa chiêu khác
                Rayfield:Notify({Title = "Za Warudo!", Content = "Cả server đứng hình!", Duration = 2})
                -- Thêm logic anchor người chơi khác ở đây
            end
        end)
    end
})

TabTime:CreateButton({
    Name = "Nhận: 🔄 Lặp Lại Quá Khứ (Rewind)",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "🔄 Lặp Lại Quá Khứ", false
        
        tool.Activated:Connect(function()
            if not TimeState.IsTransformed then return end
            if TimeState.ActiveSkill then
                Rayfield:Notify({Title = "Khóa Chiêu", Content = "Hãy tắt chiêu đang chạy!", Duration = 2})
                return
            end
            
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            
            if #TimeState.History == 0 then
                Rayfield:Notify({Title = "Thất bại", Content = "Chưa có dữ liệu quá khứ!", Duration = 2})
                return
            end
            
            TimeState.ActiveSkill = "Rewind"
            TimeState.IsRecording = false -- Tạm dừng ghi đè dữ liệu
            hum.WalkSpeed = 0
            
            local targetTime = tick() - TimeState.RewindSeconds
            local replayPath = {}
            
            -- Lọc ra các điểm vị trí trong khoảng thời gian muốn quay lại
            for i = #TimeState.History, 1, -1 do
                if TimeState.History[i].Time >= targetTime then
                    table.insert(replayPath, TimeState.History[i].CF)
                else
                    break
                end
            end
            
            Rayfield:Notify({Title = "Rewind", Content = "Tua lại " .. TimeState.RewindSeconds .. " giây...", Duration = 2})
            
            -- Lập lại hành động (Tua ngược vị trí)
            task.spawn(function()
                for i = 1, #replayPath do
                    root.CFrame = replayPath[i]
                    task.wait() -- Dịch chuyển lùi theo từng khung hình
                end
                
                -- Kết thúc
                hum.WalkSpeed = 50
                TimeState.IsRecording = true
                TimeState.ActiveSkill = nil -- Trả lại trạng thái
            end)
        end)
    end
})
