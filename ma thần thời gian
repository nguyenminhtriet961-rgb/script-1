                root.Anchored = false 
                if root:FindFirstChild("ClockOffset") then root.ClockOffset:Destroy() end
                if root:FindFirstChild("ClockScale") then root.ClockScale:Destroy() end
            end
            if workspace:FindFirstChild("BackClockModel") then workspace.BackClockModel:Destroy() end
            if workspace:FindFirstChild("ThrownClock") then workspace.ThrownClock:Destroy() end
            
            for targetRoot, isAnchored in pairs(originalAnchorStates) do
                if targetRoot and targetRoot.Parent then targetRoot.Anchored = isAnchored end
            end
            originalAnchorStates = {}
        end
        for _, v in pairs(player.Backpack:GetChildren()) do v:Destroy() end
    end
})
