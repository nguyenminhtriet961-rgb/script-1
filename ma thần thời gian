-- 3. TRỞ VỀ QUÁ KHỨ (RECALL)
-- ==========================================
TabTime:CreateButton({
    Name = "Nhận: ⏪ Trở Về Quá Khứ",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏪ Trở Về Quá Khứ", false
        local isRecalling = false
        
        tool.Activated:Connect(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") or isRecalling then return end
            if not _G.IsTimeGod then return end
            
            isRecalling = true
            local root = char.HumanoidRootPart
            local savedCFrame = root.CFrame 
            
            PlaySound(1125603704, 1, 2)
            Rayfield:Notify({Title = "Ghi Nhớ", Content = "Đã lưu vị trí. 3 giây nữa sẽ quay về quá khứ!", Duration = 3})
            
            local ghost = Instance.new("Part", workspace)
            ghost.Size = Vector3.new(2, 5, 2); ghost.CFrame = savedCFrame; ghost.Anchored = true; ghost.CanCollide = false
            ghost.Material = Enum.Material.ForceField; ghost.Color = Color3.fromRGB(0, 255, 255)
            Debris:AddItem(ghost, 3.5)
            
            task.wait(3) 
            
            PlaySound(231917744, 1.5, 3)
            TweenService:Create(Camera, TweenInfo.new(0.1), {FieldOfView = 120}):Play()
            
            local tw = TweenService:Create(root, TweenInfo.new(0.3, Enum.EasingStyle.Exponential), {CFrame = savedCFrame})
            tw:Play()
            
            task.spawn(function()
                while tw.PlaybackState == Enum.PlaybackState.Playing do CreateGhostTrail(char, 0.2, Color3.fromRGB(0, 255, 255)); task.wait(0.02) end
            end)
            
            tw.Completed:Wait()
            TweenService:Create(Camera, TweenInfo.new(0.3), {FieldOfView = 70}):Play()
            Shockwave(root.Position, Color3.fromRGB(0, 255, 255))
            
            isRecalling = false
        end)
    end
})

