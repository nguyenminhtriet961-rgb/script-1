-- 2. NGƯNG ĐỌNG THỜI GIAN (LOGIC BẤT TỬ & ĐỒNG HỒ ANIME)
-- ==========================================
TabTime:CreateButton({
    Name = "Nhận: ⏸️ Ngưng Đọng",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏸️ Ngưng Đọng", false
        
        tool.Activated:Connect(function()
            if not TimeState.IsTimeGod then return end
            if TimeState.ActiveSkill and TimeState.ActiveSkill ~= "TimeStop" then return end

            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            local backClock = workspace:FindFirstChild("BackClockModel")
            local scaleVal = root:FindFirstChild("ClockScale")
            
            if TimeState.TimeStopped then
                -- THU HỒI NGƯNG ĐỌNG
                TimeState.TimeStopped = false
                TimeState.ActiveSkill = nil 
                TimeState.ClockDetached = false -- Kết nối lại đồng hồ
                
                -- Hủy bất tử & vô hình
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.Transparency = part:GetAttribute("OrigTrans") or 0 end
                end
                if char:FindFirstChild("GodModeFF") then char.GodModeFF:Destroy() end

                if Lighting:FindFirstChild("ZaWarudoCC") then Lighting.ZaWarudoCC:Destroy() end
                
                -- Thu nhỏ đồng hồ và đưa về lưng
                if backClock and scaleVal then
                    SetModelTransparency(backClock, TimeState.PowerVisible and 0 or 1)
                    TweenService:Create(backClock.PrimaryPart, TweenInfo.new(1.5, Enum.EasingStyle.Exponential), {CFrame = root.CFrame * CFrame.new(0, 0, 2.5) * CFrame.Angles(0, math.rad(90), 0)}):Play()
                    TweenService:Create(scaleVal, TweenInfo.new(1.5, Enum.EasingStyle.Exponential), {Value = 1.5}):Play()
                end
                
                if activeTickSound then activeTickSound:Resume() end -- Phát lại tíc tắc
                
                for targetRoot, isAnchored in pairs(originalAnchorStates) do
                    if targetRoot and targetRoot.Parent then targetRoot.Anchored = isAnchored end
                end
                originalAnchorStates = {}
                PlaySound(609250266, 1, 3) 
                Rayfield:Notify({Title = "Thời gian", Content = "Thời gian tiếp tục trôi.", Duration = 2})
            else
                -- KÍCH HOẠT NGƯNG ĐỌNG
                TimeState.TimeStopped = true
                TimeState.ActiveSkill = "TimeStop" 
                TimeState.ClockDetached = true -- Ngắt kết nối đồng hồ khỏi lưng
                
                -- Bất tử bằng ForceField và tàng hình bản thể
                local ff = Instance.new("ForceField", char); ff.Name = "GodModeFF"; ff.Visible = false
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        if not part:GetAttribute("OrigTrans") then part:SetAttribute("OrigTrans", part.Transparency) end
                        part.Transparency = 1
                    end
                end
                
                PlaySound(864568856, 0.5, 5) -- Tiếng Za Warudo
                if activeTickSound then activeTickSound:Pause() end -- Dừng tíc tắc
                
                local cc = Instance.new("ColorCorrectionEffect", Lighting); cc.Name = "ZaWarudoCC"
                TweenService:Create(cc, TweenInfo.new(0.5), {Saturation = -1, Contrast = 0.5, Brightness = -0.2}):Play()
                Shockwave(root.Position, Color3.fromRGB(150, 150, 150))
                
                -- Phóng to và đưa đồng hồ lên trời 50m
                if backClock and scaleVal then
                    SetModelTransparency(backClock, 0) -- Ép hiện dù đang ẩn sức mạnh
                    local skyPos = root.CFrame * CFrame.new(0, 50, 0) * CFrame.Angles(math.rad(90), 0, 0)
                    TweenService:Create(backClock.PrimaryPart, TweenInfo.new(1.5, Enum.EasingStyle.Exponential), {CFrame = skyPos}):Play()
                    TweenService:Create(scaleVal, TweenInfo.new(1.5, Enum.EasingStyle.Exponential), {Value = 150}):Play()
                end
                
                originalAnchorStates = {}
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local tRoot = p.Character.HumanoidRootPart
                        originalAnchorStates[tRoot] = tRoot.Anchored
                        tRoot.Anchored = true 
                    end
                end
                Rayfield:Notify({Title = "Ngưng đọng!", Content = "Bản thể đã ẩn, Đồng hồ phong ấn trên trời 50m!", Duration = 3})
            end
        end)
    end
})

