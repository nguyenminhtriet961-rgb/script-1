local function PlaySound(id, pitch, vol, parent)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. tostring(id)
    s.Volume = vol or 2; s.Pitch = pitch or 1; s.Parent = parent or (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) or workspace
    s:Play(); Debris:AddItem(s, 10)
    return s
end

local function CreateGhostTrail(char, duration, color)
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local clone = part:Clone()
            clone.Parent = workspace; clone.Anchored = true; clone.CanCollide = false
            clone.Material = Enum.Material.ForceField; clone.Color = color or Color3.fromRGB(255, 215, 0)
            for _, v in pairs(clone:GetChildren()) do if not v:IsA("SpecialMesh") then v:Destroy() end end
            TweenService:Create(clone, TweenInfo.new(duration or 0.5), {Transparency = 1}):Play()
            Debris:AddItem(clone, duration or 0.5)
        end
    end
end

local function Shockwave(pos, color)
    local ring = Instance.new("Part", workspace)
    ring.Anchored = true; ring.CanCollide = false; ring.Transparency = 0; ring.Material = Enum.Material.Neon; ring.Color = color or Color3.fromRGB(255, 215, 0)
    ring.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(90), 0, 0)
    local mesh = Instance.new("SpecialMesh", ring)
    mesh.MeshId = "rbxassetid://3270017"; mesh.Scale = Vector3.new(1, 1, 0.1)
    TweenService:Create(mesh, TweenInfo.new(1, Enum.EasingStyle.Sine), {Scale = Vector3.new(150, 150, 0.1)}):Play()
    TweenService:Create(ring, TweenInfo.new(1), {Transparency = 1}):Play()
    Debris:AddItem(ring, 1)
end

local function CreateClockModel(cframe)
    local model = Instance.new("Model", workspace)
    
    local base = Instance.new("Part", model)
    base.Name = "Base"
    base.Shape = Enum.PartType.Cylinder
    base.Size = Vector3.new(0.2, 5, 5)
    base.CFrame = cframe * CFrame.Angles(0, math.rad(90), 0)
    base.Anchored = true; base.CanCollide = false; base.Massless = true
    base.Material = Enum.Material.Neon; base.Color = Color3.fromRGB(255, 255, 255) 
    model.PrimaryPart = base
    
    local outline = Instance.new("Part", model)
    outline.Shape = Enum.PartType.Cylinder
    outline.Size = Vector3.new(0.15, 5.3, 5.3)
    outline.CFrame = base.CFrame
    outline.Anchored = false; outline.CanCollide = false; outline.Color = Color3.fromRGB(0, 0, 0); outline.Massless = true
    local wOut = Instance.new("Weld", base)
    wOut.Part0 = base; wOut.Part1 = outline; wOut.C0 = CFrame.new(0,0,0)
    
    local minHand = Instance.new("Part", model)
    minHand.Size = Vector3.new(0.25, 2.2, 0.1)
    minHand.Color = Color3.fromRGB(255, 0, 0); minHand.Anchored = false; minHand.CanCollide = false; minHand.Massless = true
    local wMin = Instance.new("Weld", base)
    wMin.Part0 = base; wMin.Part1 = minHand
    wMin.C0 = CFrame.new(0.15, 0, 0); wMin.C1 = CFrame.new(0, -1.1, 0)
    
    local hrHand = Instance.new("Part", model)
    hrHand.Size = Vector3.new(0.25, 1.5, 0.15)
    hrHand.Color = Color3.fromRGB(0, 0, 0); hrHand.Anchored = false; hrHand.CanCollide = false; hrHand.Massless = true
    local wHr = Instance.new("Weld", base)
    wHr.Part0 = base; wHr.Part1 = hrHand
    wHr.C0 = CFrame.new(0.15, 0, 0); wHr.C1 = CFrame.new(0, -0.75, 0)
    
    return model, wMin, wHr
end

local function SetModelTransparency(model, trans)
    for _, part in pairs(model:GetChildren()) do
        if part:IsA("BasePart") then part.Transparency = trans end
    end
end

local function SetInvisibility(char, state)
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
            if state then
                if not obj:GetAttribute("OrigTrans") then obj:SetAttribute("OrigTrans", obj.Transparency) end
                obj.Transparency = 1
            else
                obj.Transparency = obj:GetAttribute("OrigTrans") or 0
            end
        elseif obj:IsA("Decal") then 
            if state then
                if not obj:GetAttribute("OrigTrans") then obj:SetAttribute("OrigTrans", obj.Transparency) end
                obj.Transparency = 1
            else
                obj.Transparency = obj:GetAttribute("OrigTrans") or 0
            end
        end
    end
    
    local backClock = workspace:FindFirstChild("BackClockModel")
    if backClock then
        for _, p in pairs(backClock:GetDescendants()) do
            if p:IsA("BasePart") then p.Transparency = state and 1 or 0 end
        end
    end
end

