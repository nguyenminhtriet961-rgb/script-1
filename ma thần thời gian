            TimeState.IsTimeGod = true
            
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            if hum then originalHipHeight = hum.HipHeight end
            
            hum.WalkSpeed = 0; hum.JumpPower = 0; root.Anchored = true 
