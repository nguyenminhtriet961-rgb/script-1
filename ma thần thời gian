-- 2. NGƯNG ĐỌNG THỜI GIAN (TÀNG HÌNH ẢO LÒI)
-- ==========================================
TabTime:CreateButton({
    Name = "Nhận: ⏸️ Ngưng Đọng",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏸️ Ngưng Đọng", false
        
        tool.Activated:Connect(function()
            if not TimeState.IsTimeGod then return end
            if TimeState.ActiveSkill and TimeState.ActiveSkill ~= "TimeStop" then return end

            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local root = char.HumanoidRootPart
            local offsetVal = root:FindFirstChild("ClockOffset")
            local scaleVal = root:FindFirstChild("ClockScale")
            
            if TimeState.TimeStopped then
                TimeState.TimeStopped = false
                TimeState.ActiveSkill = nil 
                
                SetInvisibility(char, false)
                Shockwave(char.HumanoidRootPart.Position, Color3.fromRGB(0, 255, 255)) 
                
                if Lighting:FindFirstChild("ZaWarudoCC") then Lighting.ZaWarudoCC:Destroy() end
                if offsetVal and scaleVal then
                    TweenService:Create(offsetVal, TweenInfo.new(1, Enum.EasingStyle.Exponential), {Value = CFrame.new(0, 0, 2.5)}):Play()
                    TweenService:Create(scaleVal, TweenInfo.new(1, Enum.EasingStyle.Exponential), {Value = 0.8}):Play()
                end
                
                for targetRoot, isAnchored in pairs(originalAnchorStates) do
                    if targetRoot and targetRoot.Parent then targetRoot.Anchored = isAnchored end
                end
                originalAnchorStates = {}
                PlaySound(609250266, 1, 3) 
            else
                TimeState.TimeStopped = true
                TimeState.ActiveSkill = "TimeStop" 
                
                SetInvisibility(char, true)
                
                PlaySound(864568856, 0.5, 5) 
                local cc = Instance.new("ColorCorrectionEffect", Lighting)
                cc.Name = "ZaWarudoCC"
                TweenService:Create(cc, TweenInfo.new(0.5), {Saturation = -1, Contrast = 0.5, Brightness = -0.2}):Play()
                Shockwave(char.HumanoidRootPart.Position, Color3.fromRGB(150, 150, 150))
                
                if offsetVal and scaleVal then
                    TweenService:Create(offsetVal, TweenInfo.new(1, Enum.EasingStyle.Exponential), {Value = CFrame.new(0, 5, 3)}):Play()
                    TweenService:Create(scaleVal, TweenInfo.new(1, Enum.EasingStyle.Exponential), {Value = 1.2}):Play()
                end
                
                originalAnchorStates = {}
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local tRoot = p.Character.HumanoidRootPart
                        originalAnchorStates[tRoot] = tRoot.Anchored
                        tRoot.Anchored = true 
                    end
                end
                Rayfield:Notify({Title = "Cảnh báo ngây thơ", Content = "Tàng hình rồi đấy (nhưng máy chủ người khác vẫn thấy nha)!", Duration = 3})
            end
        end)
    end
})

