-- Kỹ thuật Hook Metatable (Can thiệp vào bộ nhớ tạm của game)
local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__index = newcclosure(function(t, k)
    -- Nếu game đang kiểm tra WalkSpeed hoặc JumpPower từ máy tính
    if bypassed and not checkcaller() and t:IsA("Humanoid") then
        if k == "WalkSpeed" then
            return 16 -- Báo cáo láo
        elseif k == "JumpPower" then
            return 50 -- Báo cáo láo
        end
    end
    return oldIndex(t, k)
end)

setreadonly(mt, true)

