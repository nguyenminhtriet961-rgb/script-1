-- 5. LẶP LẠI HÀNH ĐỘNG (Rewind Tối Ưu Mới)
-- ==========================================
TabTime:CreateButton({
    Name = "Nhận: 🔄 Lặp Lại Quá Khứ",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "🔄 Lặp Lại Quá Khứ", false
        
        tool.Activated:Connect(function()
            if not TimeState.IsTimeGod then return end
            if TimeState.ActiveSkill then return end
            
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            
            TimeState.ActiveSkill = "Rewind"
            TimeState.IsRecording = false 
            hum.WalkSpeed = 0; hum.JumpPower = 0
            
            local targetTime = tick() - TimeState.RewindSeconds
            local replayPath = {}
            
            -- Đọc ngược bộ đệm vòng (Circular Buffer)
            local currentIndex = TimeState.HistoryIndex - 1
            if currentIndex < 1 then currentIndex = TimeState.MaxFrames end
            
            local count = 0
            while count < TimeState.MaxFrames do
                local point = TimeState.History[currentIndex]
                if point and point.Time >= targetTime then
                    table.insert(replayPath, point.CF)
                else
                    break
                end
                currentIndex = currentIndex - 1
                if currentIndex < 1 then currentIndex = TimeState.MaxFrames end
                count = count + 1
            end
            
            PlaySound(1125603704, 0.8, 3) -- Âm thanh tua ngược
            
            task.spawn(function()
                for i = 1, #replayPath do
                    root.CFrame = replayPath[i]
                    CreateGhostTrail(char, 0.2, Color3.fromRGB(0, 255, 255))
                    task.wait() 
                end
                
                hum.WalkSpeed = 50; hum.JumpPower = 50
                TimeState.IsRecording = true
                TimeState.ActiveSkill = nil 
            end)
        end)
    end
})

