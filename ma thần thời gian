TabTime:CreateButton({
    Name = "🧹 Hủy Dạng & Xóa Đồ",
    Callback = function()
        TimeState.IsTimeGod = false
        TimeState.TimeStopped = false
        TimeState.IsRecalling = false
        TimeState.ActiveSkill = nil
        TimeState.IsRecording = false
        
        if camLockConn then camLockConn:Disconnect() end
        Camera.CameraType = Enum.CameraType.Custom
        
        if ghostConn then ghostConn:Disconnect() end
        if backClockConn then backClockConn:Disconnect() end
        if recordConn then recordConn:Disconnect() end
        
        if activeTickSound then activeTickSound:Destroy(); activeTickSound = nil end
        
        if Lighting:FindFirstChild("TimeCC") then Lighting.TimeCC:Destroy() end
        if Lighting:FindFirstChild("ZaWarudoCC") then Lighting.ZaWarudoCC:Destroy() end
        
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            
            if char:FindFirstChild("GodModeFF") then char.GodModeFF:Destroy() end
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part:GetAttribute("OrigTrans") then part.Transparency = part:GetAttribute("OrigTrans") end
            end

            if hum then hum.WalkSpeed = 16; hum.JumpPower = 50; if originalHipHeight > 0 then hum.HipHeight = originalHipHeight end end
            if root then 
                root.Anchored = false 
                if root:FindFirstChild("ClockOffset") then root.ClockOffset:Destroy() end
                if root:FindFirstChild("ClockScale") then root.ClockScale:Destroy() end
            end
            if workspace:FindFirstChild("BackClockModel") then workspace.BackClockModel:Destroy() end
            if workspace:FindFirstChild("ThrownClock") then workspace.ThrownClock:Destroy() end
            
            for targetRoot, isAnchored in pairs(originalAnchorStates) do
                if targetRoot and targetRoot.Parent then targetRoot.Anchored = isAnchored end
            end
            originalAnchorStates = {}
        end
        for _, v in pairs(player.Backpack:GetChildren()) do v:Destroy() end
    end
})
