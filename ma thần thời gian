local ghostConn, backClockConn, floatingNumConn
local originalWalkSpeeds = {}
local camLockConn -- Biến để khóa cam liên tục

-- ==========================================
-- HÀM HỖ TRỢ VFX & AUDIO
-- ==========================================
local function PlaySound(id, pitch, vol, parent)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. tostring(id)
    s.Volume = vol or 2; s.Pitch = pitch or 1; s.Parent = parent or (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) or workspace
    s:Play(); Debris:AddItem(s, 10)
    return s
end

local function CreateGhostTrail(char, duration, color)
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local clone = part:Clone()
            clone.Parent = workspace; clone.Anchored = true; clone.CanCollide = false
            clone.Material = Enum.Material.ForceField; clone.Color = color or Color3.fromRGB(255, 215, 0)
            for _, v in pairs(clone:GetChildren()) do if not v:IsA("SpecialMesh") then v:Destroy() end end
            TweenService:Create(clone, TweenInfo.new(duration or 0.5), {Transparency = 1}):Play()
            Debris:AddItem(clone, duration or 0.5)
        end
    end
end

local function Shockwave(pos, color)
    local ring = Instance.new("Part", workspace)
    ring.Anchored = true; ring.CanCollide = false; ring.Transparency = 0; ring.Material = Enum.Material.Neon; ring.Color = color or Color3.fromRGB(255, 215, 0)
    ring.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(90), 0, 0)
    local mesh = Instance.new("SpecialMesh", ring)
    mesh.MeshId = "rbxassetid://3270017"; mesh.Scale = Vector3.new(1, 1, 0.1)
    TweenService:Create(mesh, TweenInfo.new(1, Enum.EasingStyle.Sine), {Scale = Vector3.new(150, 150, 0.1)}):Play()
    TweenService:Create(ring, TweenInfo.new(1), {Transparency = 1}):Play()
    Debris:AddItem(ring, 1)
end

-- TẠO ĐỒNG HỒ HÌNH TRÒN CHUẨN
local function CreateClockPart(cframe)
    local part = Instance.new("Part", workspace)
    part.Shape = Enum.PartType.Cylinder -- Ép thành hình trụ tròn
    part.Size = Vector3.new(0.2, 5, 5) -- Độ mỏng 0.2, đường kính 5
    -- Xoay Cylinder để nó đứng thẳng lên như mặt đồng hồ
    part.CFrame = cframe * CFrame.Angles(0, 0, math.rad(90))
    part.Anchored = true; part.CanCollide = false
    part.Material = Enum.Material.Neon; part.Color = Color3.fromRGB(255, 255, 255) -- Lõi trắng
    
    -- Viền đen bên ngoài
    local outline = Instance.new("Part", part)
    outline.Shape = Enum.PartType.Cylinder
    outline.Size = Vector3.new(0.15, 5.3, 5.3)
    outline.CFrame = part.CFrame
    outline.Anchored = true; outline.CanCollide = false
    outline.Color = Color3.fromRGB(0, 0, 0) -- Viền đen
    
    -- Hình dán (Decal) mặt đồng hồ
    local decalFront = Instance.new("Decal", part)
    decalFront.Texture = "rbxassetid://1440019623" -- ID mặt đồng hồ la mã
    decalFront.Face = Enum.NormalId.Right
    
    local decalBack = Instance.new("Decal", part)
    decalBack.Texture = "rbxassetid://1440019623"
    decalBack.Face = Enum.NormalId.Left
    
    return part
end

-- ==========================================
-- 1. CUTSCENE BIẾN HÌNH ĐÓNG BĂNG CAM
-- ==========================================
TabTime:CreateButton({
    Name = "Nhận: ⏳ Ấn Ký Thời Gian (Biến Hình)",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏳ Biến Hình Thời Gian", false
        local isTransforming = false
        
        tool.Activated:Connect(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") or isTransforming then return end
            
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            
            if _G.IsTimeGod then
                Rayfield:Notify({Title = "Thông báo", Content = "Đã biến hình rồi, dùng Hủy Dạng để tắt!", Duration = 2})
                return
            end
            
            isTransforming = true
            _G.IsTimeGod = true
            
            -- [1] KHÓA TOÀN BỘ CHUYỂN ĐỘNG VÀ CAMERA
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            root.Anchored = true 
            
            Camera.CameraType = Enum.CameraType.Scriptable
            -- Ép Camera nhìn thẳng mặt liên tục bằng Heartbeat (Không cho nhúc nhích)
            camLockConn = RunService.Heartbeat:Connect(function()
                local camPos = root.Position + root.CFrame.LookVector * 15 + Vector3.new(0, 2, 0)
                Camera.CFrame = CFrame.lookAt(camPos, root.Position)
            end)
            
            -- [2] HIỆN TỪ TỪ 2 ĐỒNG HỒ TRÒN 2 BÊN
            PlaySound(152835970, 0.8, 3) 
            local leftPos = root.CFrame * CFrame.new(-4, 2, 0)
            local rightPos = root.CFrame * CFrame.new(4, 2, 0)
            
            local cLeft = CreateClockPart(leftPos)
            local cRight = CreateClockPart(rightPos)
            
            -- Đặt tàng hình ban đầu
            cLeft.Transparency = 1; cLeft:FindFirstChildOfClass("Part").Transparency = 1
            for _, d in pairs(cLeft:GetChildren()) do if d:IsA("Decal") then d.Transparency = 1 end end
            
            cRight.Transparency = 1; cRight:FindFirstChildOfClass("Part").Transparency = 1
            for _, d in pairs(cRight:GetChildren()) do if d:IsA("Decal") then d.Transparency = 1 end end
            
            -- Tween hiện ra
            TweenService:Create(cLeft, TweenInfo.new(2), {Transparency = 0.2}):Play()
            TweenService:Create(cLeft:FindFirstChildOfClass("Part"), TweenInfo.new(2), {Transparency = 0}):Play()
            for _, d in pairs(cLeft:GetChildren()) do if d:IsA("Decal") then TweenService:Create(d, TweenInfo.new(2), {Transparency = 0}):Play() end end
            
            TweenService:Create(cRight, TweenInfo.new(2), {Transparency = 0.2}):Play()
            TweenService:Create(cRight:FindFirstChildOfClass("Part"), TweenInfo.new(2), {Transparency = 0}):Play()
            for _, d in pairs(cRight:GetChildren()) do if d:IsA("Decal") then TweenService:Create(d, TweenInfo.new(2), {Transparency = 0}):Play() end end
            
            task.wait(2)
            
            -- [3] ĐỒNG HỒ QUAY NHANH 3 GIÂY
            PlaySound(864568856, 1, 3) 
            local spinTw1 = TweenService:Create(cLeft, TweenInfo.new(3, Enum.EasingStyle.Linear), {CFrame = leftPos * CFrame.Angles(math.rad(360*3), 0, math.rad(90))})
            local spinTw2 = TweenService:Create(cRight, TweenInfo.new(3, Enum.EasingStyle.Linear), {CFrame = rightPos * CFrame.Angles(math.rad(-360*3), 0, math.rad(90))})
            spinTw1:Play(); spinTw2:Play()
            
            task.wait(3)
            
            -- [4] HỢP NHẤT BAY LÊN ĐẦU RỒI HẠ XUỐNG CHÂN
            local topPos = root.CFrame * CFrame.new(0, 10, 0)
            local mergeTw1 = TweenService:Create(cLeft, TweenInfo.new(1, Enum.EasingStyle.Exponential), {CFrame = topPos * CFrame.Angles(0, 0, math.rad(90))})
            local mergeTw2 = TweenService:Create(cRight, TweenInfo.new(1, Enum.EasingStyle.Exponential), {CFrame = topPos * CFrame.Angles(0, 0, math.rad(90))})
            mergeTw1:Play(); mergeTw2:Play()
            mergeTw1.Completed:Wait()
            
            cLeft:Destroy() -- Xóa trái, phải rớt xuống
            local downPos = root.CFrame * CFrame.new(0, -hum.HipHeight, 0)
            local downTw = TweenService:Create(cRight, TweenInfo.new(0.5, Enum.EasingStyle.Bounce), {CFrame = downPos * CFrame.Angles(0, math.rad(90), 0)})
            downTw:Play()
            downTw.Completed:Wait()
            
            Shockwave(root.Position, Color3.fromRGB(255, 215, 0))
            cRight:Destroy()
            
            -- [5] MỞ KHÓA CAMERA VÀ NGƯỜI CHƠI
            if camLockConn then camLockConn:Disconnect() end
            Camera.CameraType = Enum.CameraType.Custom
            root.Anchored = false
            hum.WalkSpeed = 50 
            hum.JumpPower = 50
            
            local cc = Instance.new("ColorCorrectionEffect", Lighting)
            cc.Name = "TimeCC"
            TweenService:Create(cc, TweenInfo.new(1), {TintColor = Color3.fromRGB(255, 240, 150), Contrast = 0.2}):Play()
            
            -- Tàn ảnh vàng chạy bộ (Gia Tốc)
            local timer = 0
            ghostConn = RunService.RenderStepped:Connect(function(dt)
                timer = timer + dt
                if timer > 0.15 and hum.MoveDirection.Magnitude > 0 then 
                    CreateGhostTrail(char, 0.5, Color3.fromRGB(255, 215, 0)); timer = 0 
                end
            end)
            
            -- [6] ĐỒNG HỒ BỰ SAU LƯNG QUAY LIÊN TỤC
            local backClock = CreateClockPart(root.CFrame * CFrame.new(0, 0, 2))
            backClock.Name = "BackClock"; backClock.Size = Vector3.new(0.2, 8, 8)
            backClock:FindFirstChildOfClass("Part").Size = Vector3.new(0.15, 8.3, 8.3)
            
            local weld = Instance.new("WeldConstraint", root)
            weld.Part0 = root; weld.Part1 = backClock
            weld.C0 = CFrame.new(0, 0, 2)
            
            local angle = 0
            backClockConn = RunService.Heartbeat:Connect(function(dt)
                angle = angle + math.rad(45 * dt)
                weld.C0 = CFrame.new(0, 0, 2.5) * CFrame.Angles(angle, 0, math.rad(90))
            end)
            
            -- [7] CHỮ SỐ BAY XUNG QUANH
            floatingNumConn = RunService.Heartbeat:Connect(function()
                if math.random(1, 15) == 1 then
                    local numPart = Instance.new("Part", workspace)
                    numPart.Size = Vector3.new(1,1,1); numPart.Transparency = 1; numPart.Anchored = true; numPart.CanCollide = false
                    numPart.CFrame = root.CFrame * CFrame.new(math.random(-8,8), -3, math.random(-8,8))
                    
                    local bg = Instance.new("BillboardGui", numPart)
                    bg.Size = UDim2.new(2,0,2,0); bg.AlwaysOnTop = true
                    local txt = Instance.new("TextLabel", bg)
                    txt.Size = UDim2.new(1,0,1,0); txt.BackgroundTransparency = 1
                    txt.Text = tostring(math.random(0, 9)); txt.TextColor3 = Color3.fromRGB(255, 215, 0); txt.TextScaled = true; txt.Font = Enum.Font.Code
                    
                    TweenService:Create(numPart, TweenInfo.new(4, Enum.EasingStyle.Linear), {CFrame = numPart.CFrame * CFrame.new(0, 20, 0)}):Play()
                    TweenService:Create(txt, TweenInfo.new(4), {TextTransparency = 1}):Play()
                    Debris:AddItem(numPart, 4)
                end
            end)
            
            PlaySound(5094957444, 1, 1).Looped = true
            isTransforming = false
            Rayfield:Notify({Title = "Thức tỉnh!", Content = "Gia Tốc Thời Gian đã được kích hoạt!", Duration = 3})
        end)
    end
})

-- ==========================================
-- 2. NGƯNG ĐỌNG THỜI GIAN
-- ==========================================
TabTime:CreateButton({
    Name = "Nhận: ⏸️ Ngưng Đọng Thời Gian",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏸️ Ngưng Đọng Thời Gian", false
        
        tool.Activated:Connect(function()
            if not _G.IsTimeGod then return end
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            
            if _G.TimeStopped then
                _G.TimeStopped = false
                if Lighting:FindFirstChild("ZaWarudoCC") then Lighting.ZaWarudoCC:Destroy() end
                
                for target, speed in pairs(originalWalkSpeeds) do
                    if target and target.Parent and target:IsA("Humanoid") then target.WalkSpeed = speed end
                end
                originalWalkSpeeds = {}
                PlaySound(609250266, 1, 3) 
                Rayfield:Notify({Title = "Thời gian", Content = "Thời gian tiếp tục trôi.", Duration = 2})
            else
                _G.TimeStopped = true
                PlaySound(864568856, 0.5, 5) 
                
                local cc = Instance.new("ColorCorrectionEffect", Lighting)
                cc.Name = "ZaWarudoCC"
                TweenService:Create(cc, TweenInfo.new(0.5), {Saturation = -1, Contrast = 0.5, Brightness = -0.2}):Play()
                
                Shockwave(char.HumanoidRootPart.Position, Color3.fromRGB(150, 150, 150))
                
                originalWalkSpeeds = {}
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then
                        local tHum = p.Character.Humanoid
                        originalWalkSpeeds[tHum] = tHum.WalkSpeed
                        tHum.WalkSpeed = 0 
                    end
                end
                
                Rayfield:Notify({Title = "Za Warudo!", Content = "Cả thế giới đã bị đóng băng!", Duration = 3})
            end
        end)
    end
})

-- ==========================================
-- 3. TRỞ VỀ QUÁ KHỨ (RECALL)
-- ==========================================
TabTime:CreateButton({
    Name = "Nhận: ⏪ Trở Về Quá Khứ",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏪ Trở Về Quá Khứ", false
        local isRecalling = false
        
        tool.Activated:Connect(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") or isRecalling then return end
            if not _G.IsTimeGod then return end
            
            isRecalling = true
            local root = char.HumanoidRootPart
            local savedCFrame = root.CFrame 
            
            PlaySound(1125603704, 1, 2)
            Rayfield:Notify({Title = "Ghi Nhớ", Content = "Đã lưu vị trí. 3 giây nữa sẽ quay về quá khứ!", Duration = 3})
            
            local ghost = Instance.new("Part", workspace)
            ghost.Size = Vector3.new(2, 5, 2); ghost.CFrame = savedCFrame; ghost.Anchored = true; ghost.CanCollide = false
            ghost.Material = Enum.Material.ForceField; ghost.Color = Color3.fromRGB(0, 255, 255)
            Debris:AddItem(ghost, 3.5)
            
            task.wait(3) 
            
            PlaySound(231917744, 1.5, 3)
            TweenService:Create(Camera, TweenInfo.new(0.1), {FieldOfView = 120}):Play()
            
            local tw = TweenService:Create(root, TweenInfo.new(0.3, Enum.EasingStyle.Exponential), {CFrame = savedCFrame})
            tw:Play()
            
            task.spawn(function()
                while tw.PlaybackState == Enum.PlaybackState.Playing do CreateGhostTrail(char, 0.2, Color3.fromRGB(0, 255, 255)); task.wait(0.02) end
            end)
            
            tw.Completed:Wait()
            TweenService:Create(Camera, TweenInfo.new(0.3), {FieldOfView = 70}):Play()
            Shockwave(root.Position, Color3.fromRGB(0, 255, 255))
            
            isRecalling = false
        end)
    end
})

-- ==========================================
-- 4. HỦY DẠNG
-- ==========================================
TabTime:CreateButton({
    Name = "🧹 Hủy Dạng & Xóa Đồ",
    Callback = function()
        _G.IsTimeGod = false
        _G.TimeStopped = false
        
        if camLockConn then camLockConn:Disconnect() end
        Camera.CameraType = Enum.CameraType.Custom
        
        if ghostConn then ghostConn:Disconnect() end
        if backClockConn then backClockConn:Disconnect() end
        if floatingNumConn then floatingNumConn:Disconnect() end
        
        if Lighting:FindFirstChild("TimeCC") then Lighting.TimeCC:Destroy() end
        if Lighting:FindFirstChild("ZaWarudoCC") then Lighting.ZaWarudoCC:Destroy() end
        
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum then hum.WalkSpeed = 16; hum.JumpPower = 50; hum.HipHeight = 0 end
            if root then root.Anchored = false end
            if char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart:FindFirstChild("BackClock") then 
                char.HumanoidRootPart.BackClock:Destroy() 
            end
        end
        for _, v in pairs(player.Backpack:GetChildren()) do v:Destroy() end
    end
})
