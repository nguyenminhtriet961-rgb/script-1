-- ==========================================
-- HÀM HỖ TRỢ VFX & AUDIO
-- ==========================================
local function PlaySound(id, pitch, vol, parent)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. tostring(id)
    s.Volume = vol or 2; s.Pitch = pitch or 1; s.Parent = parent or (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) or workspace
    s:Play(); Debris:AddItem(s, 10)
    return s
end

local function CreateGhostTrail(char, duration, color)
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local clone = part:Clone()
            clone.Parent = workspace; clone.Anchored = true; clone.CanCollide = false
            clone.Material = Enum.Material.ForceField; clone.Color = color or Color3.fromRGB(255, 215, 0)
            for _, v in pairs(clone:GetChildren()) do if not v:IsA("SpecialMesh") then v:Destroy() end end
            TweenService:Create(clone, TweenInfo.new(duration or 0.5), {Transparency = 1}):Play()
            Debris:AddItem(clone, duration or 0.5)
        end
    end
end

local function Shockwave(pos, color)
    local ring = Instance.new("Part", workspace)
    ring.Anchored = true; ring.CanCollide = false; ring.Transparency = 0; ring.Material = Enum.Material.Neon; ring.Color = color or Color3.fromRGB(255, 215, 0)
    ring.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(90), 0, 0)
    local mesh = Instance.new("SpecialMesh", ring)
    mesh.MeshId = "rbxassetid://3270017"; mesh.Scale = Vector3.new(1, 1, 0.1)
    TweenService:Create(mesh, TweenInfo.new(1, Enum.EasingStyle.Sine), {Scale = Vector3.new(150, 150, 0.1)}):Play()
    TweenService:Create(ring, TweenInfo.new(1), {Transparency = 1}):Play()
    Debris:AddItem(ring, 1)
end

-- TẠO ĐỒNG HỒ DẠNG MODEL ĐỂ DỄ SCALE VÀ FIX LỖI VẬT LÝ
local function CreateClockModel(cframe)
    local model = Instance.new("Model", workspace)
    
    local base = Instance.new("Part", model)
    base.Name = "Base"
    base.Shape = Enum.PartType.Cylinder
    base.Size = Vector3.new(0.2, 5, 5)
    base.CFrame = cframe * CFrame.Angles(0, math.rad(90), 0)
    base.Anchored = true; base.CanCollide = false; base.Massless = true
    base.Material = Enum.Material.Neon; base.Color = Color3.fromRGB(255, 255, 255) 
    model.PrimaryPart = base
    
    local outline = Instance.new("Part", model)
    outline.Shape = Enum.PartType.Cylinder
    outline.Size = Vector3.new(0.15, 5.3, 5.3)
    outline.CFrame = base.CFrame
    outline.Anchored = false; outline.CanCollide = false; outline.Color = Color3.fromRGB(0, 0, 0); outline.Massless = true
    local wOut = Instance.new("Weld", base)
    wOut.Part0 = base; wOut.Part1 = outline; wOut.C0 = CFrame.new(0,0,0)
    
    -- Kim phút (Đỏ)
    local minHand = Instance.new("Part", model)
    minHand.Size = Vector3.new(0.25, 2.2, 0.1)
    minHand.Color = Color3.fromRGB(255, 0, 0); minHand.Anchored = false; minHand.CanCollide = false; minHand.Massless = true
    local wMin = Instance.new("Weld", base)
    wMin.Part0 = base; wMin.Part1 = minHand
    wMin.C0 = CFrame.new(0.15, 0, 0); wMin.C1 = CFrame.new(0, -1.1, 0)
    
    -- Kim giờ (Đen)
    local hrHand = Instance.new("Part", model)
    hrHand.Size = Vector3.new(0.25, 1.5, 0.15)
    hrHand.Color = Color3.fromRGB(0, 0, 0); hrHand.Anchored = false; hrHand.CanCollide = false; hrHand.Massless = true
    local wHr = Instance.new("Weld", base)
    wHr.Part0 = base; wHr.Part1 = hrHand
    wHr.C0 = CFrame.new(0.15, 0, 0); wHr.C1 = CFrame.new(0, -0.75, 0)
    
    return model, wMin, wHr
end

-- Đổi màu/độ mờ cho toàn bộ Model
local function SetModelTransparency(model, trans)
    for _, part in pairs(model:GetChildren()) do
        if part:IsA("BasePart") then part.Transparency = trans end
    end
end

-- ==========================================
-- 1. CUTSCENE BIẾN HÌNH MỚI (LÀM THEO YÊU CẦU LỦNG CỦNG CỦA BÀ CHỊ)
-- ==========================================
TabTime:CreateButton({
    Name = "Nhận: ⏳ Ấn Ký Thời Gian (Biến Hình)",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏳ Biến Hình", false
        local isTransforming = false
        
        tool.Activated:Connect(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") or isTransforming then return end
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            
            if _G.IsTimeGod then
                Rayfield:Notify({Title = "Thông báo", Content = "Đã biến hình rồi, dùng Hủy Dạng để tắt!", Duration = 2})
                return
            end
            
            isTransforming = true
            _G.IsTimeGod = true
            
            -- Khóa cứng người và Cam
            hum.WalkSpeed = 0; hum.JumpPower = 0; root.Anchored = true 
            Camera.CameraType = Enum.CameraType.Scriptable
            camLockConn = RunService.Heartbeat:Connect(function()
                local camPos = root.Position + root.CFrame.LookVector * 15 + Vector3.new(0, 2, 0)
                Camera.CFrame = CFrame.lookAt(camPos, root.Position)
            end)
            
            -- [1] HIỆN 2 ĐỒNG HỒ (KHÔNG QUAY)
            PlaySound(152835970, 0.8, 3) 
            local leftPos = root.CFrame * CFrame.new(-4, 2, 0)
            local rightPos = root.CFrame * CFrame.new(4, 2, 0)
            
            local cLeft, lW1, lW2 = CreateClockModel(leftPos)
            local cRight, rW1, rW2 = CreateClockModel(rightPos)
            SetModelTransparency(cLeft, 1); SetModelTransparency(cRight, 1)
            
            for _, part in pairs(cLeft:GetChildren()) do if part:IsA("BasePart") then TweenService:Create(part, TweenInfo.new(2), {Transparency = 0}):Play() end end
            for _, part in pairs(cRight:GetChildren()) do if part:IsA("BasePart") then TweenService:Create(part, TweenInfo.new(2), {Transparency = 0}):Play() end end
            task.wait(2.5)
            
            -- [2] HỢP NHẤT LÊN ĐẦU RỒI RỚT TỪ TỪ XUỐNG CHÂN
            PlaySound(864568856, 1, 3) 
            local topPos = root.CFrame * CFrame.new(0, 8, 0)
            TweenService:Create(cLeft.PrimaryPart, TweenInfo.new(1, Enum.EasingStyle.Exponential), {CFrame = topPos * CFrame.Angles(0, math.rad(90), 0)}):Play()
            TweenService:Create(cRight.PrimaryPart, TweenInfo.new(1, Enum.EasingStyle.Exponential), {CFrame = topPos * CFrame.Angles(0, math.rad(90), 0)}):Play()
            task.wait(1)
            
            cLeft:Destroy() -- Hợp nhất xong xóa trái
            local downPos = root.CFrame * CFrame.new(0, -hum.HipHeight, 0)
            TweenService:Create(cRight.PrimaryPart, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = downPos * CFrame.Angles(0, math.rad(90), 0)}):Play()
            task.wait(2)
            
            Shockwave(root.Position, Color3.fromRGB(255, 215, 0))
            
            -- [3] BAY RA ĐẰNG SAU LƯNG
            local backPos = root.CFrame * CFrame.new(0, 0, 2.5)
            TweenService:Create(cRight.PrimaryPart, TweenInfo.new(1, Enum.EasingStyle.Sine), {CFrame = backPos * CFrame.Angles(0, math.rad(90), 0)}):Play()
            task.wait(1)
            
            -- Gắn cRight thành đồng hồ vĩnh viễn sau lưng
            cRight.Name = "BackClockModel"
            cRight:ScaleTo(1.5) -- Cho to ra xíu lúc đầu
            
            -- Mở khóa người chơi
            if camLockConn then camLockConn:Disconnect() end
            Camera.CameraType = Enum.CameraType.Custom
            root.Anchored = false
            hum.WalkSpeed = 50; hum.JumpPower = 50
            
            local cc = Instance.new("ColorCorrectionEffect", Lighting)
            cc.Name = "TimeCC"
            TweenService:Create(cc, TweenInfo.new(1), {TintColor = Color3.fromRGB(255, 240, 150), Contrast = 0.2}):Play()
            
            local timer = 0
            ghostConn = RunService.RenderStepped:Connect(function(dt)
                timer = timer + dt
                if timer > 0.15 and hum.MoveDirection.Magnitude > 0 then CreateGhostTrail(char, 0.5, Color3.fromRGB(255, 215, 0)); timer = 0 end
            end)
            
            -- TẠO VALUE ĐỂ LƯU VỊ TRÍ OFFSET VÀ SCALE (Cho hiệu ứng Ngưng Đọng)
            local offsetVal = Instance.new("CFrameValue", root)
            offsetVal.Name = "ClockOffset"; offsetVal.Value = CFrame.new(0, 0, 2.5)
            
            local scaleVal = Instance.new("NumberValue", root)
            scaleVal.Name = "ClockScale"; scaleVal.Value = 1.5
            
            scaleVal.Changed:Connect(function(val)
                if cRight and cRight.PrimaryPart then cRight:ScaleTo(val) end
            end)
            
            -- [4] ĐỒNG HỒ ĐỨNG YÊN, CHỈ CÓ KIM QUAY
            local kimAngle = 0
            backClockConn = RunService.Heartbeat:Connect(function(dt)
                if not root or not root.Parent then return end
                -- Đồng hồ ĐỨNG YÊN sau lưng, không xoay tròn nữa
                cRight.PrimaryPart.CFrame = root.CFrame * offsetVal.Value * CFrame.Angles(0, math.rad(90), 0)
                -- Kim quay
                kimAngle = kimAngle + math.rad(180 * dt)
                rW1.C0 = CFrame.new(0.15 * scaleVal.Value, 0, 0) * CFrame.Angles(kimAngle, 0, 0)
                rW2.C0 = CFrame.new(0.15 * scaleVal.Value, 0, 0) * CFrame.Angles(kimAngle / 12, 0, 0)
            end)
            
            PlaySound(5094957444, 1, 1).Looped = true
            isTransforming = false
            Rayfield:Notify({Title = "Thức tỉnh!", Content = "Cắt cảnh đúng ý bà nội rồi nhé!", Duration = 3})
        end)
    end
})

-- ==========================================
-- 2. NGƯNG ĐỌNG THỜI GIAN (ZA WARUDO - FIX ĐÓNG BĂNG VÀ ANIMATION)
-- ==========================================
TabTime:CreateButton({
    Name = "Nhận: ⏸️ Ngưng Đọng (Za Warudo)",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏸️ Ngưng Đọng", false
        
        tool.Activated:Connect(function()
            if not _G.IsTimeGod then return end
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local root = char.HumanoidRootPart
            local offsetVal = root:FindFirstChild("ClockOffset")
            local scaleVal = root:FindFirstChild("ClockScale")
            
            if _G.TimeStopped then
                -- TẮT NGƯNG ĐỌNG
                _G.TimeStopped = false
                if Lighting:FindFirstChild("ZaWarudoCC") then Lighting.ZaWarudoCC:Destroy() end
                
                -- Hủy Animation: Trả đồng hồ về lưng
                if offsetVal and scaleVal then
                    TweenService:Create(offsetVal, TweenInfo.new(1, Enum.EasingStyle.Exponential), {Value = CFrame.new(0, 0, 2.5)}):Play()
                    TweenService:Create(scaleVal, TweenInfo.new(1, Enum.EasingStyle.Exponential), {Value = 1.5}):Play()
                end
                
                -- Mở khóa vật lý cho người chơi khác
                for targetRoot, isAnchored in pairs(originalAnchorStates) do
                    if targetRoot and targetRoot.Parent then targetRoot.Anchored = isAnchored end
                end
                originalAnchorStates = {}
                PlaySound(609250266, 1, 3) 
                Rayfield:Notify({Title = "Thời gian", Content = "Thời gian tiếp tục trôi.", Duration = 2})
            else
                -- BẬT NGƯNG ĐỌNG
                _G.TimeStopped = true
                PlaySound(864568856, 0.5, 5) 
                
                local cc = Instance.new("ColorCorrectionEffect", Lighting)
                cc.Name = "ZaWarudoCC"
                TweenService:Create(cc, TweenInfo.new(0.5), {Saturation = -1, Contrast = 0.5, Brightness = -0.2}):Play()
                Shockwave(char.HumanoidRootPart.Position, Color3.fromRGB(150, 150, 150))
                
                -- Chạy Animation: Đưa đồng hồ lên cao và phóng to
                if offsetVal and scaleVal then
                    -- Đưa lên trên đầu (Y = 5), lùi ra sau một chút (Z = 3)
                    TweenService:Create(offsetVal, TweenInfo.new(1, Enum.EasingStyle.Exponential), {Value = CFrame.new(0, 5, 3)}):Play()
                    -- Phóng to ra gấp rưỡi (2.5)
                    TweenService:Create(scaleVal, TweenInfo.new(1, Enum.EasingStyle.Exponential), {Value = 2.5}):Play()
                end
                
                -- Đóng băng VẬT LÝ người chơi khác (Cái này mới tác dụng thật này)
                originalAnchorStates = {}
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local tRoot = p.Character.HumanoidRootPart
                        originalAnchorStates[tRoot] = tRoot.Anchored
                        tRoot.Anchored = true -- KHÓA CỨNG VỊ TRÍ
                    end
                end
                
                Rayfield:Notify({Title = "Za Warudo!", Content = "Cả server đã bị khóa cứng!", Duration = 3})
            end
        end)
    end
})

-- ==========================================
-- 3. TRỞ VỀ QUÁ KHỨ (RECALL)
-- ==========================================
TabTime:CreateButton({
    Name = "Nhận: ⏪ Trở Về Quá Khứ",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "⏪ Trở Về Quá Khứ", false
        local isRecalling = false
        
        tool.Activated:Connect(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") or isRecalling then return end
            if not _G.IsTimeGod then return end
            
            isRecalling = true
            local root = char.HumanoidRootPart
            local savedCFrame = root.CFrame 
            
            PlaySound(1125603704, 1, 2)
            Rayfield:Notify({Title = "Ghi Nhớ", Content = "Đã lưu vị trí. 3 giây nữa sẽ quay về quá khứ!", Duration = 3})
            
            local ghost = Instance.new("Part", workspace)
            ghost.Size = Vector3.new(2, 5, 2); ghost.CFrame = savedCFrame; ghost.Anchored = true; ghost.CanCollide = false
            ghost.Material = Enum.Material.ForceField; ghost.Color = Color3.fromRGB(0, 255, 255)
            Debris:AddItem(ghost, 3.5)
            
            task.wait(3) 
            
            PlaySound(231917744, 1.5, 3)
            TweenService:Create(Camera, TweenInfo.new(0.1), {FieldOfView = 120}):Play()
            
            local tw = TweenService:Create(root, TweenInfo.new(0.3, Enum.EasingStyle.Exponential), {CFrame = savedCFrame})
            tw:Play()
            
            task.spawn(function()
                while tw.PlaybackState == Enum.PlaybackState.Playing do CreateGhostTrail(char, 0.2, Color3.fromRGB(0, 255, 255)); task.wait(0.02) end
            end)
            
            tw.Completed:Wait()
            TweenService:Create(Camera, TweenInfo.new(0.3), {FieldOfView = 70}):Play()
            Shockwave(root.Position, Color3.fromRGB(0, 255, 255))
            
            isRecalling = false
        end)
    end
})

-- ==========================================
-- 4. HỦY DẠNG
-- ==========================================
TabTime:CreateButton({
    Name = "🧹 Hủy Dạng & Xóa Đồ",
    Callback = function()
        _G.IsTimeGod = false
        _G.TimeStopped = false
        
        if camLockConn then camLockConn:Disconnect() end
        Camera.CameraType = Enum.CameraType.Custom
        
        if ghostConn then ghostConn:Disconnect() end
        if backClockConn then backClockConn:Disconnect() end
        if floatingNumConn then floatingNumConn:Disconnect() end
        
        if Lighting:FindFirstChild("TimeCC") then Lighting.TimeCC:Destroy() end
        if Lighting:FindFirstChild("ZaWarudoCC") then Lighting.ZaWarudoCC:Destroy() end
        
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum then hum.WalkSpeed = 16; hum.JumpPower = 50; hum.HipHeight = 0 end
            if root then 
                root.Anchored = false 
                if root:FindFirstChild("ClockOffset") then root.ClockOffset:Destroy() end
                if root:FindFirstChild("ClockScale") then root.ClockScale:Destroy() end
            end
            if workspace:FindFirstChild("BackClockModel") then workspace.BackClockModel:Destroy() end
            
            -- Nhả người ta ra lỡ bị kẹt
            for targetRoot, isAnchored in pairs(originalAnchorStates) do
                if targetRoot and targetRoot.Parent then targetRoot.Anchored = isAnchored end
            end
            originalAnchorStates = {}
        end
        for _, v in pairs(player.Backpack:GetChildren()) do v:Destroy() end
    end
})
