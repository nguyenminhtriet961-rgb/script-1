TabTime:CreateButton({
    Name = "Nhận: 🚀 Biến Dạng Thời Gian (Lướt)",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "🚀 Biến Dạng Thời Gian", false
        
        tool.Activated:Connect(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            if not TimeState.IsTimeGod then return end
            
            if TimeState.ActiveSkill then return end 
            TimeState.ActiveSkill = "Dash"
            
            local root = char.HumanoidRootPart
            local rayOrigin = root.Position
            local rayDirection = root.CFrame.LookVector * 70 
            
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {char, workspace:FindFirstChild("BackClockModel")}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            
            local hitResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
            local targetPos = hitResult and (hitResult.Position - (root.CFrame.LookVector * 2)) or (rayOrigin + rayDirection)
            
            local thrownClock, tW1, tW2 = CreateClockModel(root.CFrame)
            thrownClock.Name = "ThrownClock"
            thrownClock:ScaleTo(0.5) 
            
            PlaySound(152835970, 2, 2) 
            
            local throwTw = TweenService:Create(thrownClock.PrimaryPart, TweenInfo.new(0.3, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos) * CFrame.Angles(0, math.rad(90), 0)})
            throwTw:Play()
            
            local throwConn = RunService.Heartbeat:Connect(function(dt)
                if tW1 and tW2 then
                    tW1.C0 = tW1.C0 * CFrame.Angles(math.rad(360 * dt * 5), 0, 0)
                    tW2.C0 = tW2.C0 * CFrame.Angles(math.rad(360 * dt * 2), 0, 0)
                end
            end)
            
            throwTw.Completed:Wait()
            if throwConn then throwConn:Disconnect() end
            
            PlaySound(231917744, 1.5, 3)
            TweenService:Create(Camera, TweenInfo.new(0.1), {FieldOfView = 100}):Play()
            
            local dashTw = TweenService:Create(root, TweenInfo.new(0.1, Enum.EasingStyle.Exponential), {CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0), targetPos + root.CFrame.LookVector * 10)})
            dashTw:Play()
            
            task.spawn(function()
                CreateGhostTrail(char, 0.5, Color3.fromRGB(255, 215, 0))
            end)
            
            dashTw.Completed:Wait()
            TweenService:Create(Camera, TweenInfo.new(0.2), {FieldOfView = 70}):Play()
            
            Shockwave(targetPos, Color3.fromRGB(255, 215, 0))
            thrownClock:Destroy()
            
            TimeState.ActiveSkill = nil
        end)
    end
})

