local TimeState = {
    IsTimeGod = false,
    TimeStopped = false,
    IsRecalling = false, 
    ActiveSkill = nil,
    History = {},
    MaxRecordTime = 15,
    RewindSeconds = 5,
    IsRecording = false,
    ClockVisible = true -- Trạng thái ẩn/hiện đồng hồ
}

local ghostConn, backClockConn, floatingNumConn, recordConn
local originalAnchorStates = {}
local originalHipHeight = 0 
local camLockConn 

local function StartRecording()
    if recordConn then recordConn:Disconnect() end
    TimeState.History = {}
    TimeState.IsRecording = true
    
    recordConn = RunService.Heartbeat:Connect(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and TimeState.IsRecording then
            local root = char.HumanoidRootPart
            table.insert(TimeState.History, { Time = tick(), CF = root.CFrame })
            
            while #TimeState.History > 0 and (tick() - TimeState.History[1].Time) > TimeState.MaxRecordTime do
                table.remove(TimeState.History, 1)
            end
        end
    end)
end

