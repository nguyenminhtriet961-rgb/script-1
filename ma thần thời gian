            -- Làm mờ rồi hiện ra
            cLeft.Transparency = 1; oL.Transparency = 1; wM1.Part1.Transparency = 1; wH1.Part1.Transparency = 1
            cRight.Transparency = 1; oR.Transparency = 1; wM2.Part1.Transparency = 1; wH2.Part1.Transparency = 1
            
            TweenService:Create(cLeft, TweenInfo.new(2), {Transparency = 0}):Play()
            TweenService:Create(oL, TweenInfo.new(2), {Transparency = 0}):Play()
            TweenService:Create(wM1.Part1, TweenInfo.new(2), {Transparency = 0}):Play()
            TweenService:Create(wH1.Part1, TweenInfo.new(2), {Transparency = 0}):Play()
            
            TweenService:Create(cRight, TweenInfo.new(2), {Transparency = 0}):Play()
            TweenService:Create(oR, TweenInfo.new(2), {Transparency = 0}):Play()
            TweenService:Create(wM2.Part1, TweenInfo.new(2), {Transparency = 0}):Play()
            TweenService:Create(wH2.Part1, TweenInfo.new(2), {Transparency = 0}):Play()
            
            task.wait(2)
            
            -- [3] KIM ĐỒNG HỒ VÀ BẢN THÂN NÓ QUAY NHANH 3 GIÂY
            PlaySound(864568856, 1, 3) 
            -- Quay cả cái khối
            TweenService:Create(cLeft, TweenInfo.new(3, Enum.EasingStyle.Linear), {CFrame = leftPos * CFrame.Angles(0, math.rad(90), math.rad(360*2))}):Play()
            TweenService:Create(cRight, TweenInfo.new(3, Enum.EasingStyle.Linear), {CFrame = rightPos * CFrame.Angles(0, math.rad(90), math.rad(-360*2))}):Play()
            -- Quay kim điên loạn
            TweenService:Create(wM1, TweenInfo.new(3, Enum.EasingStyle.Linear), {C0 = CFrame.new(0.15, 0, 0) * CFrame.Angles(math.rad(360*15), 0, 0)}):Play()
            TweenService:Create(wM2, TweenInfo.new(3, Enum.EasingStyle.Linear), {C0 = CFrame.new(0.15, 0, 0) * CFrame.Angles(math.rad(360*15), 0, 0)}):Play()
            
            task.wait(3)
            
            -- [4] HỢP NHẤT BỌN NÓ LÊN ĐẦU VÀ RỚT XUỐNG
