    Name = "MinT Thời Gian Hub ⏳",
    LoadingTitle = "Đang thao túng thời không...",
    LoadingSubtitle = "Học VSTEP đi chị gái Dược 4!",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local TabTime = Window:CreateTab("⏳ Ma Thần Thời Gian", nil)

_G.IsTimeGod = false
