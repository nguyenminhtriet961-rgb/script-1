TabTime:CreateButton({
    Name = "Nhận: 🔄 Lặp Lại Hành Động (Rewind)",
    Callback = function()
        local tool = Instance.new("Tool", player.Backpack)
        tool.Name, tool.RequiresHandle = "🔄 Lặp Lại Hành Động", false
        
        tool.Activated:Connect(function()
            if not TimeState.IsTimeGod then return end
            if TimeState.ActiveSkill then
                Rayfield:Notify({Title = "Khóa Chiêu", Content = "Hãy tắt chiêu đang chạy trước!", Duration = 2})
                return
            end
            
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChild("Humanoid")
            
            if #TimeState.History == 0 then
                Rayfield:Notify({Title = "Thất bại", Content = "Chưa có dữ liệu quá khứ!", Duration = 2})
                return
            end
            
            TimeState.ActiveSkill = "Rewind"
            TimeState.IsRecording = false 
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            
            local targetTime = tick() - TimeState.RewindSeconds
            local replayPath = {}
            
            for i = #TimeState.History, 1, -1 do
                if TimeState.History[i].Time >= targetTime then
                    table.insert(replayPath, TimeState.History[i].CF)
                else
                    break
                end
            end
            
            Rayfield:Notify({Title = "Rewind", Content = "Tua lại " .. TimeState.RewindSeconds .. " giây trước...", Duration = 2})
            PlaySound(231917744, 0.8, 3)
            
            task.spawn(function()
                for i = 1, #replayPath do
                    root.CFrame = replayPath[i]
                    CreateGhostTrail(char, 0.2, Color3.fromRGB(0, 255, 255))
                    task.wait() 
                end
                
                hum.WalkSpeed = 50
                hum.JumpPower = 50
                TimeState.IsRecording = true
                TimeState.ActiveSkill = nil 
            end)
        end)
    end
})

