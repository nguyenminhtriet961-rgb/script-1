-- ==========================================
-- HÀM HỖ TRỢ HIỆU ỨNG ĐIÊN LOẠN
-- ==========================================
local function PlayChaosSound(id, vol, pitch)
    local s = Instance.new("Sound", workspace)
    s.SoundId = "rbxassetid://" .. tostring(id); s.Volume = vol or 3; s.Pitch = pitch or 1
    s:Play(); Debris:AddItem(s, 15)
end

local function MadnessDistortion(duration)
    local start = tick()
    local cc = Instance.new("ColorCorrectionEffect", Lighting)
    local blur = Instance.new("BlurEffect", Lighting)
    
    local conn; conn = RunService.RenderStepped:Connect(function()
        if tick() - start < duration then
            cc.TintColor = Color3.new(math.random(), 0, 0)
            cc.Contrast = 5
            cc.Saturation = 2
            blur.Size = math.random(0, 20)
            Camera.FieldOfView = 70 + math.sin(tick() * 20) * 30
            Camera.CFrame *= CFrame.Angles(0, 0, math.rad(math.random(-5, 5)))
        else
            cc:Destroy(); blur:Destroy(); conn:Disconnect()
            Camera.FieldOfView = 70
        end
    end)
end

-- ==========================================
-- CÁC KỸ NĂNG DẠNG VẬT PHẨM
-- ==========================================
local function GiveMadnessTool()
    local tool = Instance.new("Tool")
    tool.Name = "👿 Ấn Ký Điên Loạn"
    tool.RequiresHandle = false
    tool.Parent = player.Backpack

    tool.Activated:Connect(function()
        local char = player.Character; local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        -- TRƯỜNG ĐOẠN BIẾN HÌNH DÀI (5 GIÂY ĐIÊN LOẠN)
        root.Anchored = true
        PlayChaosSound(864568856, 5, 0.4) -- Tiếng nổ trầm
        PlayChaosSound(138084556, 3, 0.6) -- Tiếng xé rách
        MadnessDistortion(5)

        for i = 1, 50 do
            root.CFrame *= CFrame.new(math.random(-2,2), 0.5, math.random(-2,2)) * CFrame.Angles(math.rad(math.random(-20,20)), 0, 0)
            if i % 5 == 0 then PlayChaosSound(138080210, 2, math.random(1,3)) end
            task.wait(0.1)
        end
        
        root.Anchored = false
        char.Humanoid.WalkSpeed = 150
        
        -- Tạo Aura "Mưa Máu" xung quanh
        local p = Instance.new("ParticleEmitter", root)
        p.Color = ColorSequence.new(Color3.new(0,0,0), Color3.new(1,0,0))
        p.Size = NumberSequence.new(15, 0); p.Rate = 500; p.Texture = "rbxassetid://243660364"
        p.Speed = NumberRange.new(20, 50); p.Lifetime = NumberRange.new(0.5, 1)
        
        Rayfield:Notify({Title = "MA TÍNH", Content = "Sức mạnh điên loạn đã chiếm hữu!", Duration = 5})
    end)
end

local function GiveThroneTool()
    local tool = Instance.new("Tool")
    tool.Name = "👑 Ngai Vàng Máu"
    tool.RequiresHandle = false
    tool.Parent = player.Backpack

    tool.Activated:Connect(function()
        local char = player.Character; local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        PlayChaosSound(864568856, 6, 0.3)
        MadnessDistortion(2)
        
        local m = Instance.new("Model", workspace)
        local p = Instance.new("Part", m); p.Size = Vector3.new(15, 2, 12); p.CFrame = root.CFrame * CFrame.new(0,-2,-10); p.Anchored = true; p.Color = Color3.new(0,0,0); p.Material = Enum.Material.Neon
        local b = Instance.new("Part", m); b.Size = Vector3.new(12, 20, 2); b.CFrame = p.CFrame * CFrame.new(0, 10, 5); b.Anchored = true; b.Color = Color3.new(0.2, 0, 0); b.Material = Enum.Material.Slate
        
        -- Thêm sấm sét quanh ngai vàng
        for i = 1, 10 do
            local l = Instance.new("Part", m); l.Size = Vector3.new(0.5, 20, 0.5); l.Color = Color3.new(1,0,0); l.Material = Enum.Material.Neon; l.Anchored = true
            l.CFrame = b.CFrame * CFrame.new(math.random(-10,10), 0, math.random(-5,5)) * CFrame.Angles(math.rad(math.random(0,360)),0,0)
        end
        Debris:AddItem(m, 30)
    end)
end

