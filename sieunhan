 
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "MinT Mini Hub 🔮",
    LoadingTitle = "Đang phá Cache GitHub...",
    LoadingSubtitle = "Đi ăn cơm đi bà chị ơi!",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local TabMain = Window:CreateTab("🔮 Khởi Động", nil)

TabMain:CreateSection("Script Ma Thần của Minh Triết")

TabMain:CreateButton({
    Name = "🚀 Chạy Script: Ma Thần Không Gian",
    Callback = function()
        -- Lấy link RAW chuẩn, sửa lại tên file nếu cần
        -- Lưu ý: Phải thay đúng cái link đã sửa đuôi .lua nhé
        local rawLink = "https://raw.githubusercontent.com/nguyenminhtriet961-rgb/script-1/refs/heads/main/ma%20th%E1%BA%A7n%20kh%C3%B4ng%20gian"
        
        -- Cú pháp chống lưu Cache bộ nhớ đệm (Thêm ?t=thời_gian_thực)
        local antiCacheLink = rawLink .. "?t=" .. tostring(tick())
        
        local success, err = pcall(function()
            loadstring(game:HttpGet(antiCacheLink))()
        end)
        
        if success then
            Rayfield:Notify({
                Title = "Tải thành công!",
                Content = "Nếu không hiện UI, là do code bên trong GitHub bị lỗi hoặc là code Server!",
                Duration = 4
            })
        else
            Rayfield:Notify({
                Title = "Lỗi rùi chị ơi!",
                Content = "Check lại link đi: " .. tostring(err),
                Duration = 5
            })
        end
    end
})

TabMain:CreateButton({
    Name = "❌ Tắt Menu Này",
    Callback = function()
        Rayfield:Destroy()
    end
})
