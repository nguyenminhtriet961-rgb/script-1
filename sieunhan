-- Hàm chạy Script cực mạnh (Phá Cache + Bắt Lỗi)
local function LoadScript(link)
    -- Thêm tham số thời gian để ép Delta tải bản mới nhất, không dùng bản cũ
    local antiCacheLink = link .. "?t=" .. tostring(tick())
    
    local success, err = pcall(function()
        loadstring(game:HttpGet(antiCacheLink))()
    end)
    
    if success then
        Rayfield:Notify({
            Title = "Tải thành công!",
            Content = "Nếu UI không hiện, kêu thằng Triết check lại code của nó!",
            Duration = 4
        })
    else
        Rayfield:Notify({
            Title = "Lỗi đường dẫn!",
            Content = "Link chết hoặc GitHub bị Private: " .. tostring(err),
            Duration = 5
        })
    end
end

